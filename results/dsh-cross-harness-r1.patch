+#!/usr/bin/env python3
+"""Tests for report.py's SVG output: text from labels and the command line is escaped, the documents are well-formed XML.
+
+Run from the repository root:  python3 -m unittest discover -s bench -p "test_report.py"
+"""
+
+import importlib.util
+import io
+import json
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+from contextlib import redirect_stdout
+from pathlib import Path
+from unittest import mock
+
+_spec = importlib.util.spec_from_file_location("report", Path(__file__).with_name("report.py"))
+report = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(report)
+
+BUILDS = ["pi-bolt", "bun"]
+PANELS = [("Launch to interactive", "ms", {"pi-bolt": 100.0, "bun": 250.0})]
+TILES = [("Ready to type", "ms", {"pi-bolt": 100.0, "bun": 250.0}, "faster")]
+# A label that would close the <text> element, open a script (or an img with a handler) and add markup and an entity.
+EVIL = '</text><script>alert(1)</script><img src=x onerror="alert(2)">&amp;"\''
+EVIL_TITLE = 'Time & "<script>"'
+
+
+def local(tag):
+    """The tag without its SVG namespace."""
+    return tag.rpartition("}")[2]
+
+
+def parse(path):
+    return ET.fromstring(Path(path).read_text(encoding="utf-8"))
+
+
+def texts(root):
+    return ["".join(el.itertext()) for el in root.iter() if local(el.tag) == "text"]
+
+
+def tags(root):
+    return {local(el.tag) for el in root.iter()}
+
+
+class Base(unittest.TestCase):
+    """A temporary directory, and LABELS as it was (the charts name builds through it, which --label and main() change)."""
+
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.tmp = Path(tmp.name)
+        self.addCleanup(tmp.cleanup)
+        labels = dict(report.LABELS)
+
+        def restore():
+            report.LABELS.clear()
+            report.LABELS.update(labels)
+
+        self.addCleanup(restore)
+
+
+class EscapeTest(unittest.TestCase):
+    def test_special_characters_are_escaped_once(self):
+        self.assertEqual(report.svg_text("R&D <b>"), "R&amp;D &lt;b&gt;")
+        self.assertEqual(report.svg_text("a &amp; b"), "a &amp;amp; b")  # (an entity in the input is text, not an entity)
+        self.assertEqual(report.svg_text("2.5× faster"), "2.5× faster")  # (nothing to escape)
+        self.assertEqual(report.svg_text(12), "12")
+
+    def test_attribute_quotes_are_escaped(self):
+        self.assertEqual(report.svg_attr('He said "hi" & \'bye\''),
+                         "He said &quot;hi&quot; &amp; &apos;bye&apos;")
+        self.assertEqual(report.svg_attr("a\tb\nc"), "a&#9;b&#10;c")
+
+    def test_unicode_is_preserved(self):
+        for text in ("Café", "日本語", "Pi‑Bolt", "🚀 2.5×"):
+            self.assertEqual(report.svg_text(text), text)
+            self.assertEqual(report.svg_attr(text), text)
+
+    def test_characters_xml_forbids_are_dropped(self):
+        self.assertEqual(report.svg_text("a\x00b\x1bc"), "abc")
+        self.assertEqual(report.svg_attr("a\x0bb"), "ab")
+        self.assertEqual(report.svg_text("a\ud800b"), "ab")  # (a lone surrogate, as a broken JSONL label can carry)
+
+    def test_ordinary_ascii_is_unchanged(self):
+        for text in ("Pi-Bolt 1.0.0", "Bun 1.4.2", "CPU, 20,000-char answer", "2.9× faster", "–"):
+            self.assertEqual(report.svg_text(text), text)
+            self.assertEqual(report.svg_attr(text), text)
+
+
+class ChartTest(Base):
+    def chart(self, title="Time", subtitle="Lower is better.", evil=False):
+        path = self.tmp / "chart.svg"
+        if evil:
+            report.LABELS["evil"] = EVIL
+            report.chart(title, subtitle, [(n, u, {**v, "evil": 120.0}) for n, u, v in PANELS], BUILDS + ["evil"],
+                         "light", path)
+        else:
+            report.chart(title, subtitle, PANELS, BUILDS, "light", path)
+        return path
+
+    def test_document_parses_and_ordinary_labels_are_untouched(self):
+        path = self.chart()
+        root = parse(path)
+        raw = path.read_text(encoding="utf-8")
+        self.assertEqual(root.get("aria-label"), "Time: Lower is better.")
+        self.assertEqual(texts(root)[:3], ["Time", "Lower is better.", "Launch to interactive"])
+        self.assertIn("Pi-Bolt", texts(root))
+        self.assertIn("Bun 1.4.2", texts(root))
+        self.assertNotIn("&", raw)  # (nothing to escape: the same text as before)
+
+    def test_malicious_label_cannot_inject_elements(self):
+        path = self.chart(evil=True)
+        raw = path.read_text(encoding="utf-8")
+        root = parse(path)  # (the point: a standard XML parser accepts it)
+        self.assertEqual(tags(root) & {"script", "img"}, set())
+        self.assertNotIn("<script", raw)
+        self.assertEqual(len(texts(root)), 10)  # (nothing added: 3 headings, 3 labels, 3 values, 1 ratio)
+        self.assertIn(EVIL, texts(root))  # (read back exactly as it went in: escaped once)
+
+    def test_malicious_title_and_subtitle_are_text(self):
+        root = parse(self.chart(EVIL_TITLE, EVIL + "2"))
+        self.assertEqual(root.get("aria-label"), f"{EVIL_TITLE}: {EVIL}2")
+        self.assertEqual(texts(root)[:2], [EVIL_TITLE, EVIL + "2"])
+        self.assertEqual(tags(root) & {"script", "img"}, set())
+
+    def test_unicode_label_survives(self):
+        report.LABELS["unicode"] = "Pi‑Bolt 日本 🚀"
+        path = self.tmp / "unicode.svg"
+        report.chart("Temps", "Plus bas, c'est mieux.", [("Lancement", "ms", {"pi-bolt": 1.0, "unicode": 2.0})],
+                     ["pi-bolt", "unicode"], "light", path)
+        root = parse(path)
+        self.assertIn("Pi‑Bolt 日本 🚀", texts(root))
+        self.assertIn("Lancement", texts(root))
+        self.assertEqual(root.get("aria-label"), "Temps: Plus bas, c'est mieux.")
+
+
+class HeroTest(Base):
+    def test_document_parses(self):
+        path = self.tmp / "hero.svg"
+        report.hero(TILES, BUILDS, "light", path, "Pi-Bolt", "Lower is better.")
+        root = parse(path)
+        self.assertEqual(root.get("aria-label"), "Pi-Bolt")
+        self.assertEqual(texts(root)[:3], ["Pi-Bolt", "Lower is better.", "Ready to type"])
+        self.assertIn("Bun 1.4.2", texts(root))
+        self.assertIn("2.5× faster than Bun", texts(root))
+
+    def test_malicious_names_cannot_inject_elements(self):
+        report.LABELS["evil"] = EVIL
+        path = self.tmp / "hero-evil.svg"
+        report.hero([(EVIL_TITLE, "ms", {"pi-bolt": 1.0, "evil": 9.0}, "faster")], ["pi-bolt", "evil"], "dark", path,
+                    EVIL, EVIL, compare=[("evil", EVIL)])
+        raw = path.read_text(encoding="utf-8")
+        root = parse(path)
+        self.assertEqual(tags(root) & {"script", "img"}, set())
+        self.assertNotIn("<script", raw)
+        self.assertEqual(root.get("aria-label"), EVIL)
+        self.assertIn(EVIL_TITLE, texts(root))
+        self.assertIn(EVIL, texts(root))  # (the build's label)
+        self.assertTrue(any(t.startswith("9.0× faster than") and t.endswith(EVIL) for t in texts(root)))
+
+    def test_unit_span_is_escaped(self):
+        path = self.tmp / "hero-unit.svg"
+        report.hero([("Ready", "a&b", {"pi-bolt": 12.0, "bun": 20.0}, "faster")], BUILDS, "light", path)
