+class CommandLineTest(Base):
+    """--label and --builds are the strings a caller controls: the whole tool, end to end."""
+
+    @staticmethod
+    def rows(evil_build):
+        def row(build, scenario, **fields):
+            return {"build": build, "scenario": scenario, "ok": True, **fields}
+        return [row("pi-bolt", "interactive", tti_ms=100.0, cpu_ms=200.0, peak_mb=50.0),
+                row("bun", "interactive", tti_ms=250.0, cpu_ms=400.0, peak_mb=90.0),
+                row(evil_build, "interactive", tti_ms=120.0, cpu_ms=210.0, peak_mb=60.0),
+                row("pi-bolt", "startup", wall_ms=5.0, cpu_ms=6.0),
+                row("bun", "startup", wall_ms=9.0, cpu_ms=10.0)]
+
+    def test_label_and_build_name_from_the_command_line(self):
+        evil_build = "<script>alert('build')</script>"
+        results, images = self.tmp / "results", self.tmp / "images"
+        results.mkdir()
+        lines = [json.dumps(r) for r in self.rows(evil_build)]
+        # (What the other tools leave: a long session and a terminal session, so the hero has all its figures.)
+        lines += [json.dumps({"build": b, "prompt": "p1", "own_mb": 120.0, "ms_per_prompt": 90.0, "cpu_ms_per_prompt": 50.0})
+                  for b in ("pi-bolt", "bun", evil_build)]
+        (results / "benchmark.jsonl").write_text("\n".join(lines[:5]) + "\n", encoding="utf-8")
+        (results / "long.jsonl").write_text("\n".join(lines[5:]) + "\n", encoding="utf-8")
+        (results / "tmux.jsonl").write_text(
+            "\n".join(json.dumps({"build": b, "prompt_cpu_ms": 300.0, "memory_at_end": {"own": 80.0}})
+                      for b in ("pi-bolt", "bun")) + "\n", encoding="utf-8")
+        argv = ["report.py", str(results), "--images", str(images), "--builds", f"pi-bolt,bun,{evil_build}",
+                "--label", f"pi-bolt={EVIL}"]
+        with mock.patch.object(sys, "argv", argv), redirect_stdout(io.StringIO()):
+            report.main()
+        svgs = sorted(images.glob("*.svg"))
+        self.assertEqual(len(svgs), 8, [p.name for p in svgs])  # (four charts, light and dark)
+        for svg in svgs:
+            root = parse(svg)
+            self.assertEqual(tags(root) & {"script", "img"}, set(), svg.name)
+            self.assertNotIn("<script", svg.read_text(encoding="utf-8"), svg.name)
+        speed = parse(images / "bench-speed-light.svg")
+        self.assertIn(EVIL, texts(speed))
+        self.assertIn(evil_build, texts(speed))
+        self.assertIn(EVIL, texts(parse(images / "bench-hero-dark.svg")))
