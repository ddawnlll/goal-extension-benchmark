+    """A string for a double-quoted SVG attribute value (aria-label): svg_text and the quotes, tab, newline and return.
+
+    The whitespace is written as references because an XML parser normalises whitespace in an attribute value otherwise,
+    and the value read back should be the one that went in."""
+    quotes = {'"': "&quot;", "'": "&apos;", "\t": "&#9;", "\n": "&#10;", "\r": "&#13;"}
+    return escape(NOT_XML.sub("", str(value)), quotes)
