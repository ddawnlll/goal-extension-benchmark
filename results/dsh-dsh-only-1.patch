+# XML 1.0 characters: tab, line feed, carriage return, and the rest of Unicode except lone surrogates and U+FFFE/U+FFFF.
+# (Labels from JSON may carry control characters, which would make even correctly escaped SVG unparseable.)
+XML_INVALID = re.compile("[^\t\n\r\x20-\ud7ff\ue000-\ufffd\U00010000-\U0010ffff]")
+XML_ESCAPES = str.maketrans({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&apos;"})
+
+
+def escape_xml(text):
+    """Escape text once for an SVG text node or a quoted attribute, preserving valid Unicode.
+
+    Invalid XML characters become U+FFFD. Widths are measured on the unescaped text, since an entity is one character
+    on screen; escape only where the text is written into the document.
+    """
+    return XML_INVALID.sub("\ufffd", str(text)).translate(XML_ESCAPES)
 
 
