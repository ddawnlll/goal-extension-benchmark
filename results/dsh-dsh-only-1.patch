+#!/usr/bin/env python3
+"""Regression tests for bench/report.py's SVG escaping.
+
+Run from the repository root: python3 bench/test_report.py
+"""
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "bench"))
+
+import report  # noqa: E402  (after the path above)
+
+SVG = "{http://www.w3.org/2000/svg}"
+PAYLOAD = "& < > \" ' café 日本語 😀 × –"
+INJECTION = '</text><script>alert("x")</script><text onload="alert(1)">'
+
+
+def parse_svg(path):
+    return ET.parse(path).getroot()
+
+
+def texts(root):
+    return ["".join(element.itertext()) for element in root.iter() if element.tag == SVG + "text"]
+
+
+class SvgAssertions:
+    def assert_safe_svg(self, path):
+        root = parse_svg(path)
+        for element in root.iter():
+            self.assertNotEqual(element.tag, SVG + "script")
+            self.assertNotEqual(element.tag, SVG + "image")
+            for attribute in element.attrib:
+                self.assertFalse(attribute.lower().startswith("on"), f"event attribute in {path}")
+        raw = path.read_text(encoding="utf-8")
+        self.assertNotIn("<script", raw)
+        self.assertNotIn("<text onload=", raw)
+        return root
+
+
+class EscapeXmlTests(unittest.TestCase):
+    def test_special_characters_are_escaped(self):
+        self.assertEqual(report.escape_xml("&<>\"'"), "&amp;&lt;&gt;&quot;&apos;")
+        self.assertEqual(report.escape_xml("A & B"), "A &amp; B")
+
+    def test_valid_unicode_is_preserved(self):
+        text = "café – 日本語 😀 ×"
+        self.assertEqual(report.escape_xml(text), text)
+
+    def test_invalid_xml_characters_are_replaced(self):
+        self.assertEqual(report.escape_xml("\x00\x01\x0b\ud800"), "\ufffd\ufffd\ufffd\ufffd")
+        self.assertEqual(report.escape_xml("\t\n\r"), "\t\n\r")
+
+    def test_entity_like_text_is_not_decoded(self):
+        self.assertEqual(report.escape_xml("&amp;"), "&amp;amp;")
+
+
+class ChartEscapingTests(unittest.TestCase, SvgAssertions):
+    def setUp(self):
+        self.labels = report.LABELS.copy()
+        self.addCleanup(self.restore_labels)
+
+    def restore_labels(self):
+        report.LABELS.clear()
+        report.LABELS.update(self.labels)
+
+    def test_chart_escapes_titles_labels_and_panel_names(self):
+        title = "Title " + INJECTION + PAYLOAD
+        subtitle = "Subtitle " + PAYLOAD
+        panel = "Panel " + INJECTION + PAYLOAD
+        build = 'build<&"\'>'
+        report.LABELS[build] = PAYLOAD
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "chart.svg"
+            report.chart(title, subtitle, [(panel, "ms", {"pi-bolt": 2.0, build: 4.0}, "time")],
+                         ["pi-bolt", build], "light", path)
+            root = self.assert_safe_svg(path)
+            self.assertEqual(root.get("aria-label"), f"{title}: {subtitle}")
+            found = texts(root)
+            for expected in (title, subtitle, panel, PAYLOAD, "2.0 ms", "4.0 ms"):
+                self.assertIn(expected, found)
+
+    def test_chart_replaces_characters_invalid_in_xml(self):
+        title = "Bad \x00 and \ud800 title"
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "chart.svg"
+            report.chart(title, "subtitle", [("panel", "ms", {"pi-bolt": 1.0}, "time")],
+                         ["pi-bolt"], "light", path)
+            root = self.assert_safe_svg(path)
+            self.assertEqual(root.get("aria-label"), "Bad \ufffd and \ufffd title: subtitle")
+            self.assertIn("Bad \ufffd and \ufffd title", texts(root))
+
+
+class HeroEscapingTests(unittest.TestCase, SvgAssertions):
+    def setUp(self):
+        self.labels = report.LABELS.copy()
+        self.addCleanup(self.restore_labels)
+
+    def restore_labels(self):
+        report.LABELS.clear()
+        report.LABELS.update(self.labels)
+
+    def test_hero_escapes_title_comparison_and_build_labels(self):
+        title = "Hero " + INJECTION + PAYLOAD
+        subtitle = "Subtitle " + PAYLOAD
+        tile = "Tile " + INJECTION + PAYLOAD
+        compare_name = "Compare " + INJECTION + PAYLOAD
+        build = 'build<&"\'>'
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "hero.svg"
+            report.hero([(tile, "ms", {"pi-bolt": 1.0, build: 2.0}, "faster")], ["pi-bolt", build], "dark", path,
+                        title=title, subtitle=subtitle, compare=[(build, compare_name)])
+            root = self.assert_safe_svg(path)
+            self.assertEqual(root.get("aria-label"), title)
+            found = texts(root)
+            for expected in (title, subtitle, tile, f"2.0× faster than {compare_name}", build):
+                self.assertIn(expected, found)
+
+
+class CommandLineTests(unittest.TestCase, SvgAssertions):
+    def test_cli_escapes_labels_build_names_and_metadata_steps(self):
+        label = "Pi & Bolt \"quote\" 'apostrophe'"
+        build = 'bun</text><script>alert("build")</script>'
+        step = 'write:</text><script>alert("step")</script>'
+        with tempfile.TemporaryDirectory() as tmp:
+            results = Path(tmp) / "results"
+            images = Path(tmp) / "images"
+            results.mkdir()
+            rows = []
+            for name in ("pi-bolt", build):
+                rows += [
+                    {"ok": True, "build": name, "scenario": "interactive", "tti_ms": 10.0, "cpu_ms": 20.0,
+                     "peak_mb": 30.0, "peak_fp_mb": 10.0},
+                    {"ok": True, "build": name, "scenario": "startup", "wall_ms": 5.0, "cpu_ms": 3.0},
+                    {"ok": True, "build": name, "scenario": "headless", "wall_ms": 6.0, "cpu_ms": 4.0},
+                ]
+            (results / "benchmark.jsonl").write_text(
+                "".join(json.dumps(row, ensure_ascii=False) + "\n" for row in rows), encoding="utf-8")
+            (results / "long.jsonl").write_text("".join(json.dumps(
+                {"build": name, "prompt": "p", "ms_per_prompt": 1.0, "cpu_ms_per_prompt": 2.0,
+                 "own_mb": 25.0, "tokens_m": 1.2}, ensure_ascii=False) + "\n"
+                for name in ("pi-bolt", build)), encoding="utf-8")
+            (results / "tmux.jsonl").write_text("".join(json.dumps(
+                {"build": name, "prompt_cpu_ms": 7.0, "memory_at_end": {"own": 20.0}}, ensure_ascii=False) + "\n"
+                for name in ("pi-bolt", build)), encoding="utf-8")
+            (results / "pauses.jsonl").write_text(json.dumps(
+                {"build": "pi-bolt", "step": step, "gc_logged": False, "frame_ms_p99": 4.0, "longest_ms": 8.0},
+                ensure_ascii=False) + "\n", encoding="utf-8")
+            env = os.environ.copy()
+            env["PYTHONUTF8"] = "1"
+            completed = subprocess.run(
+                [sys.executable, str(ROOT / "bench" / "report.py"), str(results), "--images", str(images),
+                 "--builds", f"pi-bolt,{build}", "--label", f"pi-bolt={label}"],
+                cwd=ROOT, env=env, capture_output=True, text=True, encoding="utf-8")
+            self.assertEqual(completed.returncode, 0, completed.stderr)
+            svgs = sorted(images.glob("*.svg"))
+            self.assertGreaterEqual(len(svgs), 4)
+            found = []
+            for path in svgs:
+                self.assert_safe_svg(path)
+                found += texts(parse_svg(path))
+            self.assertIn(label, found)
+            self.assertIn(build, found)
+            step_text = step.partition(":")[2]
+            self.assertTrue(any(step_text in text for text in found), "metadata step missing from the SVG")
+
+
+if __name__ == "__main__":
+    unittest.main()
