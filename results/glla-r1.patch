+#!/usr/bin/env python3
+"""Tests for bench/report.py's SVG output: text and attribute escaping, injection, Unicode, and byte-identical ordinary charts.
+
+Run from the repo root: python3 -m unittest bench/test_report.py -v
+Standard library only: the writer is checked through xml.etree, a standard XML parser, not through string matching alone.
+"""
+
+import importlib.util
+import subprocess
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+BENCH = Path(__file__).resolve().parent
+SVG = "{http://www.w3.org/2000/svg}"
+FIXTURE = BENCH / "fixtures" / "report"
+GOLDEN = BENCH / "fixtures" / "report-golden"
+
+
+def load_report():
+    spec = importlib.util.spec_from_file_location("bench_report", BENCH / "report.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+report = load_report()
+
+
+def texts(root):
+    """Every text node's string content, tspan children included."""
+    return [t.text or "" for t in root.iter(SVG + "text")]
+
+
+def tag_names(root):
+    return {el.tag for el in root.iter()}
+
+
+def attributes(root):
+    return {name for el in root.iter() for name in el.attrib}
+
+
+class EscapingTest(unittest.TestCase):
+    """The helper itself: what it produces for each kind of input."""
+
+    def test_special_characters_become_entities(self):
+        self.assertEqual(report.esc('& < > " \''), "&amp; &lt; &gt; &quot; &#x27;")
+
+    def test_each_character_is_escaped_once(self):
+        self.assertEqual(report.esc("Tom & Jerry"), "Tom &amp; Jerry")
+        # A literal entity in the input is text: & of "&amp;" is escaped, the rest is not escaped again.
+        self.assertEqual(report.esc("&amp;"), "&amp;amp;")
+
+    def test_ordinary_text_is_unchanged(self):
+        for text in ("Pi-Bolt 1.0.0", "CPU, 20,000-char answer", "pi -p: one prompt, 4 tool calls", ""):
+            self.assertEqual(report.esc(text), text)
+
+    def test_unicode_is_preserved(self):
+        # What fmt() and ratio_text() already emit, and labels people write.
+        for text in ("–", "2.9× faster", "Niños", "日本語のラベル", "🚀"):
+            self.assertEqual(report.esc(text), text)
+
+    def test_illegal_xml_code_points_are_dropped(self):
+        self.assertEqual(report.esc("a\x00b\x0bc\x1fd"), "abcd")
+        self.assertEqual(report.esc("x\ud800y"), "xy")
+        self.assertEqual(report.esc("x\ufffey"), "xy")
+
+    def test_attribute_values_use_the_same_escape(self):
+        self.assertEqual(report.attr('a"b\'c<&>'), "a&quot;b&#x27;c&lt;&amp;&gt;")
+
+
+class ChartTest(unittest.TestCase):
+    """chart(): the panel chart writer."""
+
+    def setUp(self):
+        self.labels, self.pi_version = dict(report.LABELS), list(report.PI_VERSION)
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def tearDown(self):
+        report.LABELS.clear()
+        report.LABELS.update(self.labels)
+        report.PI_VERSION[:] = self.pi_version
+
+    def write(self, title="Time", subtitle="Wall-clock time, lower is better", name="Launch", labels=()):
+        for build, text in labels:
+            report.LABELS[build] = text
+        path = Path(self.dir.name) / "chart.svg"
+        report.chart(title, subtitle, [(name, "ms", {"pi-bolt": 100, "bun": 200})], ["pi-bolt", "bun"], "light", path)
+        return path.read_text(), ET.parse(path).getroot()
+
+    def test_special_characters_in_text_are_escaped(self):
+        raw, root = self.write(title="A & B", subtitle='x < y "z"')
+        self.assertIn("A &amp; B", raw)
+        self.assertIn("x &lt; y &quot;z&quot;", raw)
+        self.assertIn("A & B", texts(root))
+
+    def test_label_cannot_inject_an_element(self):
+        raw, root = self.write(labels=[("bun", "</text><script>alert(1)</script>")])
+        self.assertNotIn("<script", raw)
+        self.assertNotIn(SVG + "script", tag_names(root))
+        self.assertIn("</text><script>alert(1)</script>", texts(root))  # shown as its literal characters
+
+    def test_label_cannot_inject_an_attribute(self):
+        raw, root = self.write(labels=[("bun", 'x" onload="alert(1)')])
+        self.assertNotIn("onload", attributes(root))
+        self.assertNotIn('onload="', raw.replace("&quot;", ""))
+        self.assertIn('x" onload="alert(1)', texts(root))
+
+    def test_panel_name_is_escaped(self):
+        raw, root = self.write(name="</text><circle r='9'/>")
+        self.assertNotIn(SVG + "circle", tag_names(root))
+        self.assertNotIn("<circle", raw)
+        self.assertIn("</text><circle r='9'/>", texts(root))
+
+    def test_label_rendered_once_is_escaped_once(self):
+        raw, _ = self.write(labels=[("bun", "A & B")])
+        self.assertIn("A &amp; B", raw)
+        self.assertNotIn("A &amp;amp; B", raw)
+
+    def test_document_parses(self):
+        _, root = self.write(labels=[("bun", "<b>&amp;</b>")])
+        self.assertEqual(root.tag, SVG + "svg")
+        self.assertIn("Time: Wall-clock time, lower is better", root.attrib["aria-label"])
+
+
+class HeroTest(unittest.TestCase):
+    """hero(): the headline figure, whose big value embeds a <tspan> for the unit."""
+
+    def setUp(self):
+        self.labels, self.pi_version = dict(report.LABELS), list(report.PI_VERSION)
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def tearDown(self):
+        report.LABELS.clear()
+        report.LABELS.update(self.labels)
+        report.PI_VERSION[:] = self.pi_version
+
+    def write(self, title="Pi-Bolt", subtitle="Compared", name="Ready to type", label="Bun 1.4.2"):
+        report.LABELS["bun"] = label
+        path = Path(self.dir.name) / "hero.svg"
+        tiles = [(name, "ms", {"pi-bolt": 100, "bun": 200}, "faster")]
+        report.hero(tiles, ["pi-bolt", "bun"], "light", path, title, subtitle)
+        return path.read_text(), ET.parse(path).getroot()
+
+    def test_unit_tspan_is_still_an_element(self):
+        raw, root = self.write()
+        spans = [el for el in root.iter(SVG + "tspan")]
+        self.assertEqual([s.text for s in spans], ["ms"])
+        # The value and the unit stay text, not escaped markup.
+        self.assertIn(">100<tspan", raw)
+
+    def test_title_attribute_and_subtitle_are_escaped(self):
+        raw, root = self.write(title='A & B "q"', subtitle="x < y")
+        # In the document the attribute carries entities; a parser reads the original text back.
+        self.assertIn('aria-label="A &amp; B &quot;q&quot;', raw)
+        self.assertEqual(root.attrib["aria-label"], 'A & B "q"')
+        self.assertIn("x &lt; y", raw)
+        self.assertIn("x < y", texts(root))
+
+    def test_hostile_tile_name_and_label_are_text(self):
+        raw, root = self.write(name="</text><script>alert(1)</script>", label='"><image href="x"/>')
+        self.assertNotIn(SVG + "script", tag_names(root))
+        self.assertNotIn(SVG + "image", tag_names(root))
+        self.assertNotIn("<script", raw)
+        self.assertIn('"><image href="x"/>', texts(root))
+
+    def test_unicode_label_survives(self):
+        _, root = self.write(label="Bun 1.4.2 – 日本語")
+        self.assertIn("Bun 1.4.2 – 日本語", texts(root))
+
+    def test_label_in_two_places_is_escaped_once_in_each(self):
+        # The legend row and the "2.0× faster than ..." line both name the build: one escape per insertion, not two.
+        raw, root = self.write(label="A&B")
+        self.assertEqual(raw.count("A&amp;B"), 2)
+        self.assertNotIn("&amp;amp;", raw)
+        self.assertIn("faster than A&amp;B", raw)
+        self.assertEqual(texts(root).count("A&B"), 1)
+
+
+class ReportRunTest(unittest.TestCase):
+    """report.py end to end: the CLI, the fixtures, and every document through the XML parser."""
+
+    def run_report(self, results, images, extra=()):
+        command = [sys.executable, str(BENCH / "report.py"), str(results), "--images", str(images),
+                   "--builds", "pi-bolt,bun,node", *extra]
+        done = subprocess.run(command, capture_output=True, text=True)
+        self.assertEqual(done.returncode, 0, done.stderr)
+        return sorted(Path(images).glob("*.svg"))
+
+    def test_ordinary_input_is_byte_identical_to_the_golden_charts(self):
+        # The charts of bench/fixtures/report as the writer drew them before escaping was added: same bytes, same picture.
+        with tempfile.TemporaryDirectory() as tmp:
+            drawn = self.run_report(FIXTURE, tmp)
+            golden = sorted(GOLDEN.glob("*.svg"))
+            self.assertEqual([p.name for p in drawn], [p.name for p in golden])  # every chart, none dropped
+            for path in drawn:
+                self.assertEqual(path.read_bytes(), (GOLDEN / path.name).read_bytes(), path.name)
+
+    def test_every_generated_document_parses(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            drawn = self.run_report(FIXTURE, tmp)
+            self.assertTrue(drawn)
+            for path in drawn:
+                ET.parse(path)
+
+    def test_hostile_label_through_the_cli_parses(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            drawn = self.run_report(FIXTURE, tmp, ["--label", 'bun=</text><script>alert(1)</script>'])
+            for path in drawn:
+                root = ET.parse(path).getroot()
+                self.assertNotIn(SVG + "script", tag_names(root))
+                self.assertNotIn("onload", attributes(root))
+            raw = drawn[0].read_text()
+            self.assertNotIn("<script", raw)
+
+    def test_real_results_folder_parses(self):
+        results = BENCH / "results" / "2026-10-12-linux-x64-0.8.5"
+        if not results.is_dir():
+            self.skipTest("results folder not present")
+        with tempfile.TemporaryDirectory() as tmp:
+            drawn = self.run_report(results, tmp)
+            self.assertTrue(drawn)
+            for path in drawn:
+                ET.parse(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
