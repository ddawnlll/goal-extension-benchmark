diff --git a/bench/test_report.py b/bench/test_report.py
new file mode 100644
index 000000000..1a794a546
--- /dev/null
+++ b/bench/test_report.py
@@ -0,0 +1,359 @@
+#!/usr/bin/env python3
+"""Tests of the SVG charts bench/report.py writes: ordinary names, hostile names, and documents a parser accepts.
+
+A name a chart shows can come from --label, --builds, environment.txt or a results file, so a chart must stay well-formed
+whatever it says, and a name must never add an element, an attribute or a script. Run:
+
+  python3 bench/test_report.py
+  python3 -m unittest discover -s bench -p 'test_*.py'
+
+Standard library only (unittest, xml.etree, tempfile); the results files are read, never written.
+"""
+
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import report  # noqa: E402
+
+REPORT = Path(__file__).resolve().parent / "report.py"
+PUBLISHED = Path(__file__).resolve().parent / "results" / "2026-10-12-linux-x64-0.8.5"
+
+# A label that closes the text node, opens a script, and tries to leave the attribute it was put in.
+HOSTILE = 'Bun & <script>alert(1)</script>"><svg onload=alert(1)>'
+HOSTILE_ATTR = 'x" onload="alert(1)'
+# What a label must survive as text: closing the element, CDATA end, an event handler, an entity and a whole document.
+HOSTILE_PAYLOADS = (HOSTILE, HOSTILE_ATTR, "</text><script>alert(1)</script>", "]]>", "' onload='alert(1)", "&amp;",
+                    "<svg xmlns='http://www.w3.org/2000/svg'><script>alert(1)</script></svg>")
+
+# Every element and attribute the writers emit, and nothing else: what a label cannot add.
+ALLOWED = {
+    "svg": {"width", "height", "viewBox", "role", "aria-label"},
+    "style": set(),
+    "text": {"x", "y", "font-size", "font-weight", "fill", "text-anchor"},
+    "path": {"d", "fill"},
+    "line": {"x1", "y1", "x2", "y2", "stroke"},
+    "rect": {"x", "y", "width", "height", "rx", "fill"},
+    "tspan": {"font-size", "font-weight", "fill", "dx"},
+}
+
+
+def tag_of(element):
+    """A chart declares xmlns, which ElementTree resolves into the tag: the local name is what the writers emit."""
+    return element.tag.rsplit("}", 1)[-1]
+
+
+def named(root, name):
+    return [el for el in root.iter() if tag_of(el) == name]
+
+
+def check_markup(case, root, where):
+    """Fail when the document holds an element or attribute the writers do not emit (a label that got through), and when the
+    style element carries more than the font rule."""
+    for el in root.iter():
+        case.assertIn(tag_of(el), ALLOWED, f"{where}: a label became an element <{tag_of(el)}>")
+        for name in el.attrib:
+            case.assertIn(name, ALLOWED[tag_of(el)], f"{where}: a label became the attribute {name} on <{tag_of(el)}>")
+    styles = [el.text or "" for el in named(root, "style")]
+    case.assertEqual(len(styles), 1, f"{where}: exactly one style element (the font rule)")
+    case.assertNotIn("<", styles[0], f"{where}: the style element holds only the font rule")
+
+
+def texts(root):
+    return [el.text or "" for el in named(root, "text")]
+
+
+def inventory(root):
+    return [(tag_of(el), tuple(sorted(el.attrib))) for el in root.iter()]
+
+
+def draw_chart(directory, title="Time", subtitle="Wall-clock time, medians.", builds=("pi-bolt", "bun"),
+               panels=None, theme="light", name="chart.svg"):
+    path = Path(directory) / name
+    panels = panels if panels is not None else [("Launch to interactive (TUI)", "ms", {"pi-bolt": 38.0, "bun": 110.0})]
+    report.chart(title, subtitle, panels, list(builds), theme, path)
+    return path, ET.parse(path).getroot()
+
+
+def draw_hero(directory, tiles=None, builds=("pi-bolt", "bun"), title="Ready to type",
+              subtitle="Pi 1.1.0, medians.", compare=None, name="hero.svg"):
+    path = Path(directory) / name
+    tiles = tiles if tiles is not None else [("Ready to type", "ms", {"pi-bolt": 38.0, "bun": 110.0}, "faster")]
+    report.hero(tiles, list(builds), "light", path, title, subtitle, compare)
+    return path, ET.parse(path).getroot()
+
+
+def run_report(args):
+    """report.py as a user runs it: its own process, so the tests see what the command line produces."""
+    return subprocess.run([sys.executable, str(REPORT), *map(str, args)], capture_output=True, text=True)
+
+
+class EscapingTest(unittest.TestCase):
+    def test_the_five_markup_characters(self):
+        self.assertEqual(report.xml_text("a & b < c > d"), "a &amp; b &lt; c &gt; d")
+        self.assertEqual(report.xml_attr('say "hi" & <go>'), '\'say "hi" &amp; &lt;go&gt;\'')
+        self.assertIn("&quot;", report.xml_attr('say "hi" & \'there\''))
+
+    def test_ordinary_labels_are_left_alone(self):
+        for text in ("Time", "Pi-Bolt 1.0.0", "Bun 1.4.2", "38 ms", "2.9× faster", "–", "CPU, 20,000-char answer"):
+            self.assertEqual(report.xml_text(text), text)
+            self.assertEqual(report.xml_attr(text), f'"{text}"')
+
+    def test_unicode_survives(self):
+        text = "日本語 – × 🚀 ⏱"
+        self.assertEqual(report.xml_text(text), text)
+        with tempfile.TemporaryDirectory() as directory:
+            path, root = draw_chart(directory, builds=("pi-bolt", text))
+            self.assertIn(text, texts(root))
+            self.assertIn(text, path.read_text(encoding="utf-8"))
+
+    def test_code_points_xml_cannot_carry_become_replacement_characters(self):
+        self.assertEqual(report.xml_text("a\x01b\x02c"), "a\ufffdb\ufffdc")
+        for text in ("\x00", "\ufffe", "\uffff", "\ud800"):
+            self.assertEqual(report.xml_text(text), "\ufffd")
+            self.assertIn(report.xml_attr(text), ('"\ufffd"', "'\ufffd'"))
+
+    def test_tab_newline_and_carriage_return_stay_legal(self):
+        self.assertEqual(report.xml_text("a\tb\nc\rd"), "a\tb\nc\rd")
+        self.assertEqual(report.xml_attr("a\tb"), '"a&#9;b"')  # (an attribute keeps them as references)
+
+
+class ChartSvgTest(unittest.TestCase):
+    def test_ordinary_chart_keeps_its_text_and_its_layout(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path, root = draw_chart(directory)
+            raw = path.read_text(encoding="utf-8")
+            self.assertNotIn("&amp;", raw)
+            self.assertNotIn("&lt;", raw)
+            self.assertEqual(root.get("aria-label"), "Time: Wall-clock time, medians.")
+            shown = texts(root)
+            self.assertIn("Time", shown)
+            self.assertIn("Pi-Bolt", shown)
+            self.assertIn("Bun 1.4.2", shown)
+            self.assertIn("38 ms", shown)
+            check_markup(self, root, "ordinary chart")
+
+    def test_title_subtitle_and_build_labels_cannot_inject_markup(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path, root = draw_chart(directory, title=HOSTILE, subtitle=f'{HOSTILE} & "quote" \'apostrophe\'',
+                                    builds=("pi-bolt", HOSTILE_ATTR, HOSTILE))
+            check_markup(self, root, "hostile chart")
+            self.assertEqual(named(root, "script"), [])
+            self.assertEqual(path.read_text(encoding="utf-8").count("<script>"), 0)
+            self.assertIn(HOSTILE, texts(root))
+            self.assertEqual(root.get("aria-label"), f'{HOSTILE}: {HOSTILE} & "quote" \'apostrophe\'')
+
+    def test_quote_in_a_label_cannot_leave_the_attribute(self):
+        with tempfile.TemporaryDirectory() as directory:
+            _, root = draw_chart(directory, builds=("pi-bolt", HOSTILE_ATTR))
+            check_markup(self, root, "attribute breakout")
+            self.assertEqual(len(root.attrib), 5)  # width, height, viewBox, role, aria-label
+            self.assertIn(HOSTILE_ATTR, texts(root))
+
+    def test_no_double_escaping(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path, root = draw_chart(directory, builds=("pi-bolt", "&amp;", "&lt;"))
+            # Escaped once: the parser gives back the text the label had, not the entity.
+            self.assertIn("&amp;", texts(root))
+            self.assertIn("&lt;", texts(root))
+            raw = path.read_text(encoding="utf-8")
+            self.assertIn("&amp;amp;", raw)
+            self.assertIn("&amp;lt;", raw)
+
+    def test_hostile_labels_add_no_element_and_no_attribute(self):
+        with tempfile.TemporaryDirectory() as directory:
+            ordinary_panels = [("Launch", "ms", {"pi-bolt": 38.0, "bun": 110.0})]
+            hostile_panels = [("Launch", "ms", {"pi-bolt": 38.0, HOSTILE_ATTR: 110.0})]
+            _, ordinary = draw_chart(directory, name="ordinary.svg", panels=ordinary_panels)
+            _, hostile = draw_chart(directory, name="hostile.svg", title=HOSTILE, subtitle=HOSTILE,
+                                    builds=("pi-bolt", HOSTILE_ATTR), panels=hostile_panels)
+            # (Same shapes and attributes element for element: a label changed text, nothing else.)
+            self.assertEqual(inventory(ordinary), inventory(hostile))
+
+    def test_every_hostile_payload_stays_text(self):
+        for payload in HOSTILE_PAYLOADS:
+            with self.subTest(payload=payload), tempfile.TemporaryDirectory() as directory:
+                panels = [("Launch", "ms", {"pi-bolt": 38.0, payload: 110.0})]
+                _, root = draw_chart(directory, title=payload, subtitle=payload, builds=("pi-bolt", payload),
+                                     panels=panels)
+                check_markup(self, root, f"payload {payload!r}")
+                self.assertEqual(named(root, "script"), [])
+                self.assertIn(payload, texts(root))
+                self.assertEqual(root.get("aria-label"), f"{payload}: {payload}")
+
+    def test_control_characters_do_not_break_the_document(self):
+        with tempfile.TemporaryDirectory() as directory:
+            _, root = draw_chart(directory, title="a\x01b", builds=("pi-bolt", "c\ufffed"))
+            check_markup(self, root, "control characters")
+            self.assertIn("a\ufffdb", texts(root))
+
