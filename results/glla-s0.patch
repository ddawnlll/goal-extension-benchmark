+class GeneratedChartsTest(unittest.TestCase):
+    """report.py end to end, on a results folder: the datasets it reads, through the command line it keeps."""
+
+    def fixture(self, directory, benchmark, plugins=None, pauses=None, long_rows=None, tmux_rows=None):
+        """A results folder the way the benchmarks write one: the fields report.py reads, in the files it reads them from."""
+        results = Path(directory) / "results"
+        results.mkdir()
+
+        def write(name, rows):
+            (results / name).write_text("\n".join(json.dumps(r) for r in rows) + "\n", encoding="utf-8")
+
+        write("benchmark.jsonl", benchmark)
+        write("long.jsonl", long_rows or [])
+        write("tmux.jsonl", tmux_rows or [])
+        if plugins:
+            write("plugins.jsonl", plugins)
+        if pauses:
+            write("pauses.jsonl", pauses)
+        return results
+
+    def full_fixture(self, directory, extra=None):
+        """Every file report.py draws from, so all of its charts are written."""
+        benchmark = []
+        for build, tti in (("pi-bolt", 30.0), ("bun", 36.0)):
+            for scenario, wall in (("startup", 10.0), ("headless", 11.0), ("interactive", tti)):
+                benchmark.append({"build": build, "scenario": scenario, "ok": True, "wall_ms": wall,
+                                  "cpu_ms": wall * 2, "tti_ms": tti, "peak_mb": 40.0, "peak_own_mb": 41.0})
+        long_rows = [{"build": "pi-bolt", "prompt": 1, "own_mb": 100.0, "ms_per_prompt": 5.0,
+                      "cpu_ms_per_prompt": 6.0, "tokens_m": 1.0}]
+        tmux_rows = [{"build": "pi-bolt", "prompt_cpu_ms": 50.0, "frame_ms_p99": 8.0,
+                      "memory_at_end": {"own": 90.0, "private_ws": 88.0}}]
+        return self.fixture(directory, benchmark, long_rows=long_rows, tmux_rows=tmux_rows,
+                            **(extra or {}))
+
+    def test_synthetic_results_with_hostile_dataset_names(self):
+        plugins = [{"build": HOSTILE, "plugin": "compiled", "launch_ms": 5.0, "loop_ms": [1.0, 2.0]},
+                   {"build": HOSTILE, "plugin": "run time", "launch_ms": 7.0, "loop_ms": [2.0, 3.0]}]
+        pauses = [{"build": "pi-bolt", "step": f"weird{HOSTILE}", "gc_logged": False, "frame_ms_p99": 12.0}]
+        with tempfile.TemporaryDirectory() as directory:
+            results = self.full_fixture(directory, {"plugins": plugins, "pauses": pauses})
+            images = Path(directory) / "images"
+            run = run_report([results, "--images", images, "--builds", "pi-bolt,bun"])
+            self.assertEqual(run.returncode, 0, run.stderr)
+            charts = sorted(images.glob("*.svg"))
+            self.assertEqual(len(charts), 10)  # speed, cpu, memory, plugins and hero, each light and dark
+            for chart in charts:
+                root = ET.parse(chart).getroot()
+                check_markup(self, root, chart.name)
+                self.assertEqual(named(root, "script"), [], chart.name)
+                self.assertEqual(chart.read_text(encoding="utf-8").count("<script>"), 0, chart.name)
+            # (The plugins chart names its columns from the datasets' build ids, the memory chart a step from pauses.jsonl.)
+            plugins_chart = ET.parse(images / "bench-plugins-light.svg").getroot()
+            self.assertTrue(any(HOSTILE in text for text in texts(plugins_chart)))
+            self.assertNotIn(HOSTILE, (images / "bench-plugins-light.svg").read_text(encoding="utf-8"))
+            memory_chart = ET.parse(images / "bench-memory-light.svg").getroot()
+            self.assertTrue(any(HOSTILE in text for text in texts(memory_chart)))
+
+    def test_hostile_label_from_the_command_line(self):
+        with tempfile.TemporaryDirectory() as directory:
+            results = self.full_fixture(directory)
+            images = Path(directory) / "images"
+            run = run_report([results, "--images", images, "--builds", "pi-bolt,bun", "--label", f"bun={HOSTILE}"])
