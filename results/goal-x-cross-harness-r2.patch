+#!/usr/bin/env python3
+"""Tests for bench/report.py: the SVG it writes stays valid XML whatever text results, --label and the command line supply.
+
+Run from the repository root:
+    python3 -m unittest bench.test_report
+or
+    python3 bench/test_report.py
+"""
+
+import importlib.util
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+REPORT = HERE / "report.py"
+_spec = importlib.util.spec_from_file_location("bench_report", REPORT)
+report = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(report)
+
+DEFAULT_LABELS = dict(report.LABELS)
+SVG = "{http://www.w3.org/2000/svg}"
+# Everything report.py draws. A label that turns into anything else has injected markup.
+ALLOWED = {"svg", "style", "text", "tspan", "path", "line", "rect"}
+HOSTILE = "</text><script>alert('pwned')</script><rect onload=\"x\"/>"
+QUOTED = 'A & B "quoted" \'singled\' <tag> &amp; done'
+UNICODE = "Pi-Bolt – 2.9× faster, 日本語, 🧪"
+GOLDEN = """<svg xmlns="http://www.w3.org/2000/svg" width="880" height="198" viewBox="0 0 880 198" role="img" aria-label="Time: Wall-clock time, lower is better.">
+<style>text{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif}</style>
+<text x="24" y="32" font-size="21" font-weight="650" fill="#1f2328">Time</text>
+<text x="24" y="56" font-size="13.5" fill="#59636e">Wall-clock time, lower is better.</text>
+<text x="24" y="96" font-size="15" font-weight="600" fill="#1f2328">Launch to interactive (TUI)</text>
+<text x="94" y="126.5" font-size="13.5" text-anchor="end" fill="#59636e">Pi-Bolt</text>
+<path d="M104,114 h80.7 a4,4 0 0 1 4,4 v8 a4,4 0 0 1 -4,4 h-80.7 z" fill="#2a78d6"/>
+<text x="196.7" y="126.5" font-size="13.5" font-weight="650" fill="#1f2328">120 ms</text>
+<text x="256.8" y="126.5" font-size="12.5" fill="#59636e">2.8× faster</text>
+<text x="94" y="156.5" font-size="13.5" text-anchor="end" fill="#59636e">Bun 1.4.2</text>
+<path d="M104,144 h236.0 a4,4 0 0 1 4,4 v8 a4,4 0 0 1 -4,4 h-236.0 z" fill="#848d97"/>
+<text x="352.0" y="156.5" font-size="13.5" font-weight="400" fill="#1f2328">340 ms</text>
+<line x1="104" y1="108" x2="104" y2="166" stroke="#d1d9e0"/>
+</svg>
+"""
+
+
+def tags(root):
+    return [el.tag.removeprefix(SVG) for el in root.iter()]
+
+
+def texts(root):
+    """The text of every leaf text node, in document order."""
+    return [el.text for el in root.iter() if el.tag in (f"{SVG}text", f"{SVG}tspan") and el.text is not None]
+
+
+def chart_svg(path, title="Time", subtitle="Lower is better.",
+              panels=None, builds=("pi-bolt", "bun"), theme="light"):
+    panels = panels or [("Launch", "ms", {"pi-bolt": 120.0, "bun": 340.0})]
+    report.chart(title, subtitle, panels, list(builds), theme, path)
+    return path.read_text(encoding="utf-8")
+
+
+def hero_svg(path, tiles=None, builds=("pi-bolt", "bun"), theme="light", **kw):
+    tiles = tiles or [("Ready to type", "ms", {"pi-bolt": 120.0, "bun": 340.0}, "faster")]
+    report.hero(tiles, list(builds), theme, path, **kw)
+    return path.read_text(encoding="utf-8")
+
+
+class SvgCase(unittest.TestCase):
+    def setUp(self):
+        report.LABELS.clear()
+        report.LABELS.update(DEFAULT_LABELS)
+        report.PI_VERSION[0] = "1.0.0"
+        self._tmp = tempfile.TemporaryDirectory()
+        self.tmp = Path(self._tmp.name)
+
+    def tearDown(self):
+        self._tmp.cleanup()
+        report.LABELS.clear()
+        report.LABELS.update(DEFAULT_LABELS)
+
+    def draw_chart(self, **kw):
+        svg = chart_svg(self.tmp / "chart.svg", **kw)
+        return svg, ET.fromstring(svg)
+
+    def draw_hero(self, **kw):
+        svg = hero_svg(self.tmp / "hero.svg", **kw)
+        return svg, ET.fromstring(svg)
+
+    def assertOnlySvgMarkup(self, root):
+        """No element report.py does not draw, and no attribute that could run anything."""
+        self.assertEqual([], [t for t in tags(root) if t not in ALLOWED], "label injected markup")
+        for el in root.iter():
+            for name in el.attrib:
+                self.assertFalse(name.lower().startswith("on"), f"event handler on {el.tag}: {name}")
+                self.assertNotIn(name, ("href", "xlink:href", "src", "style"), f"{el.tag} gained {name}")
+
+
+class HelperTest(SvgCase):
+    def test_plain_text_is_untouched(self):
+        for plain in ("Pi-Bolt 1.0.3", "Bun 1.4.2", "Node 22", "Pi-Bolt (JIT on)", UNICODE):
+            self.assertEqual(plain, report.svg_text(plain))
+            self.assertEqual(f'"{plain}"', report.svg_attr(plain))
+
+    def test_text_node_escapes_markup_characters(self):
+        self.assertEqual("A &amp; B &lt;x&gt;", report.svg_text("A & B <x>"))
+
+    def test_attribute_escapes_quotes(self):
+        self.assertEqual("\"a 'b' &amp; &lt;c&gt;\"", report.svg_attr("a 'b' & <c>"))
+        # (A value holding a double quote is wrapped in single quotes instead: both are valid, either is escaped.)
+        self.assertEqual('\'a "b" &amp; &lt;c&gt;\'', report.svg_attr('a "b" & <c>'))
+
+
+class ChartTest(SvgCase):
+    def test_ordinary_chart_is_byte_identical_to_before(self):
+        self.assertEqual(GOLDEN, chart_svg(self.tmp / "golden.svg", subtitle="Wall-clock time, lower is better.",
+                                          panels=[("Launch to interactive (TUI)", "ms", {"pi-bolt": 120.0, "bun": 340.0})]))
+
+    def test_hostile_build_label_cannot_inject(self):
+        report.LABELS["bun"] = HOSTILE
+        svg, root = self.draw_chart()
+        self.assertOnlySvgMarkup(root)
+        self.assertIn(HOSTILE, texts(root))
+        self.assertNotIn("<script", svg)
+
+    def test_hostile_title_subtitle_and_panel_name(self):
+        svg, root = self.draw_chart(title=HOSTILE, subtitle=QUOTED,
+                                    panels=[(HOSTILE, "ms", {"pi-bolt": 120.0, "bun": 340.0})])
+        self.assertOnlySvgMarkup(root)
+        self.assertEqual(f"{HOSTILE}: {QUOTED}", root.get("aria-label"))
+        self.assertIn(HOSTILE, texts(root))
+        self.assertIn(QUOTED, texts(root))
+        self.assertNotIn("<script", svg)
+
+    def test_no_double_escaping(self):
+        report.LABELS["bun"] = "AT&T <b>"
+        svg, root = self.draw_chart()
+        self.assertIn("AT&T <b>", texts(root))
+        self.assertEqual(1, svg.count("AT&amp;T"))
+        self.assertNotIn("&amp;amp;", svg)
+        self.assertNotIn("&amp;lt;", svg)
+
+    def test_unicode_is_preserved(self):
+        report.LABELS["bun"] = UNICODE
+        svg, root = self.draw_chart(title=UNICODE, subtitle=UNICODE,
+                                    panels=[(UNICODE, "ms", {"pi-bolt": 120.0, "bun": 340.0})])
+        self.assertIn(UNICODE, texts(root))
+        self.assertEqual(f"{UNICODE}: {UNICODE}", root.get("aria-label"))
+        self.assertIn("2.9×", svg)
+
+    def test_quotes_in_attribute_stay_in_the_attribute(self):
+        title = 'He said "go" & <left> '
+        svg = chart_svg(self.tmp / "q.svg", title=title)
+        root = ET.fromstring(svg)
+        self.assertEqual(f"{title}: Lower is better.", root.get("aria-label"))
+        self.assertNotIn("<left>", svg)
+        self.assertIn("&lt;left&gt;", svg)
+
+    def test_dark_theme_document_parses(self):
+        svg = chart_svg(self.tmp / "dark.svg", title=HOSTILE, theme="dark")
+        self.assertOnlySvgMarkup(ET.fromstring(svg))
+
+
+class HeroTest(SvgCase):
+    def test_ordinary_hero_parses_and_keeps_its_tspan(self):
+        svg = hero_svg(self.tmp / "hero.svg")
+        root = ET.fromstring(svg)
+        self.assertOnlySvgMarkup(root)
+        figures = [el for el in root.findall(f".//{SVG}text") if el.find(f"{SVG}tspan") is not None]
+        self.assertEqual(1, len(figures), "the unit tspan is still markup")
+        self.assertEqual("ms", figures[0].find(f"{SVG}tspan").text)
+        self.assertEqual("120", figures[0].text)
+
+    def test_hostile_hero_title_subtitle_and_labels(self):
+        report.LABELS["pi-bolt"] = HOSTILE
+        report.LABELS["bun"] = QUOTED
+        svg = hero_svg(self.tmp / "hero.svg", title=HOSTILE, subtitle=QUOTED)
+        root = ET.fromstring(svg)
+        self.assertOnlySvgMarkup(root)
+        self.assertEqual(HOSTILE, root.get("aria-label"))
+        self.assertIn(HOSTILE, texts(root))
+        self.assertIn(QUOTED, texts(root))
+        self.assertNotIn("<script", svg)
+
+    def test_hostile_compare_name_cannot_inject(self):
+        report.LABELS["pi-bolt"] = "Pi-Bolt"
+        report.LABELS["bun"] = HOSTILE
+        svg = hero_svg(self.tmp / "hero.svg", compare=[("bun", HOSTILE), ("bun", UNICODE)])
+        root = ET.fromstring(svg)
+        self.assertOnlySvgMarkup(root)
+        self.assertTrue(any("faster than " in t for t in texts(root)))
+        self.assertIn(UNICODE, " ".join(texts(root)))
+        self.assertNotIn("<script", svg)
+
+    def test_dark_hero_parses_with_hostile_input(self):
+        report.LABELS["bun"] = HOSTILE
+        svg = hero_svg(self.tmp / "hero-dark.svg", title=HOSTILE, theme="dark")
+        self.assertOnlySvgMarkup(ET.fromstring(svg))
+
+
+class CommandLineTest(SvgCase):
+    """The whole path: a results folder, --label on the command line, every SVG written."""
+
+    def run_report(self, label):
+        results = self.tmp / "results"
+        results.mkdir()
+        (results / "environment.txt").write_text(
+            "pi-bolt: 1.0.0 (Pi-Bolt 0.8.5, linux-x64, JIT off)\nbun: Pi 1.0.0 on stock Bun 1.4.2\nnode: v22.11.0\n",
+            encoding="utf-8")
+        rows = [{"build": b, "scenario": s, "ok": True, "tti_ms": tti, "wall_ms": tti, "cpu_ms": tti * 4,
