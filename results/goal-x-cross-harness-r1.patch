diff --git a/tests/pi/report_svg.py b/tests/pi/report_svg.py
new file mode 100644
index 000000000..c0f20b0c1
--- /dev/null
+++ b/tests/pi/report_svg.py
@@ -0,0 +1,178 @@
+"""The SVGs bench/report.py draws must be valid XML whatever the labels say: labels come from --label and environment.txt,
+so a label such as `</text><script>alert(1)</script>` must stay text, not become markup.
+  python tests/pi/report_svg.py
+No Pi executable needed: builds the charts directly and runs report.py against a throwaway results folder.
+"""
+import json
+import subprocess
+import sys
+import tempfile
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+repo = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(repo / "bench"))
+import report  # noqa: E402
+
+PAYLOADS = [
+    "</text><script>alert(1)</script>",
+    '" onload="alert(1)',
+    "' onmouseover='alert(1)",
+    "A & B < C > D",
+    "Ünïcode – 日本 × 1.0",
+    "&amp;",
+    "<tspan>fake</tspan>",
+]
+ALLOWED_TAGS = {"svg", "style", "text", "tspan", "line", "rect", "path"}
+failures = []
+
+
+def check(ok, name, detail=""):
+    print(("PASS " if ok else "FAIL ") + name + (f"\n   {detail}" if not ok and detail else ""))
+    if not ok:
+        failures.append(name)
+
+
+def with_labels(mapping):
+    """Set LABELS for the duration of a `with` block."""
+    class Labels:
+        def __enter__(self):
+            self.saved = dict(report.LABELS)
+            report.LABELS.update(mapping)
+
+        def __exit__(self, *exc):
+            report.LABELS.clear()
+            report.LABELS.update(self.saved)
+    return Labels()
+
+
+def parse(path):
+    return ET.parse(path).getroot()
+
+
+def texts(root):
+    return [t.text or "" for t in root.iter() if t.tag.rsplit("}", 1)[-1] in ("text", "tspan")]
+
+
+def assert_safe(root):
+    """No markup injected and nothing that runs script: only the elements chart() and hero() draw."""
+    bad_tags = {e.tag.rsplit("}", 1)[-1] for e in root.iter()} - ALLOWED_TAGS
+    on_attrs = [a for e in root.iter() for a in e.attrib if a.rsplit("}", 1)[-1].lower().startswith("on")]
+    return not bad_tags and not on_attrs, (bad_tags, on_attrs)
+
+
+def chart_case(tmp):
+    panels = [
+        ("Time per prompt, 4.2M-token session", "ms", {"pi-bolt": 1.0, "bun": 2.0}),
+        ("Peak memory & <streaming>", "MB", {"pi-bolt": 3.0, "bun": 4.0}),
+    ]
+    out = tmp / "chart.svg"
+    with with_labels({"pi-bolt": PAYLOADS[0], "bun": PAYLOADS[3]}):
+        report.chart(f"Title {PAYLOADS[1]}", f"Sub {PAYLOADS[2]}", panels, ["pi-bolt", "bun"], "light", out)
+    root = parse(out)
+    ok, detail = assert_safe(root)
+    check(ok, "chart: injected labels stay text and add no elements or handlers", str(detail))
+    labels = texts(root)
+    check(PAYLOADS[0] in labels, "chart: build label round-trips exactly (decoded once)", repr(labels))
+    check(PAYLOADS[3] in labels, "chart: & < > label round-trips exactly", repr(labels))
+    check(f"Title {PAYLOADS[1]}" in labels and f"Sub {PAYLOADS[2]}" in labels,
+          "chart: title and subtitle round-trip exactly", repr(labels))
+    check(PAYLOADS[1] in root.get("aria-label", ""), "chart: aria-label round-trips exactly", root.get("aria-label"))
+    raw = out.read_text()
+    check("<script" not in raw and "&lt;script" in raw and "&quot; onload" in raw,
+          "chart: raw SVG holds escaped payload, not literal markup")
+    check("&amp;amp;" not in raw, "chart: no double escaping", raw)
+
+
+def hero_case(tmp):
+    tiles = [("Ready & <set>", "ms", {"pi-bolt": 1.0, "bun": 2.0}, "faster"),
+             ("Memory", "MB", {"pi-bolt": 3.0, "bun": 4.0}, "less")]
+    out = tmp / "hero.svg"
+    with with_labels({"pi-bolt": PAYLOADS[0], "bun": PAYLOADS[2]}):
+        report.hero(tiles, ["pi-bolt", "bun"], "dark", out, f"Hero {PAYLOADS[1]}", f"Note {PAYLOADS[3]}")
+    root = parse(out)
+    ok, detail = assert_safe(root)
+    check(ok, "hero: injected labels stay text and add no elements or handlers", str(detail))
+    labels = texts(root)
+    check(PAYLOADS[0] in labels, "hero: build label round-trips exactly", repr(labels))
+    check(f"Hero {PAYLOADS[1]}" in labels, "hero: title round-trips exactly", repr(labels))
+    check(f"Hero {PAYLOADS[1]}" in root.get("aria-label", ""), "hero: aria-label round-trips exactly", root.get("aria-label"))
+    raw = out.read_text()
+    check("&amp;amp;" not in raw and "<script" not in raw, "hero: no double escaping or literal markup")
+
+
+def escape_case():
+    check(report.svg_text("&<>\"'") == "&amp;&lt;&gt;&quot;&apos;", "svg_text escapes & < > \" '")
+    check(report.svg_text("Ünïcode – 日本 ×") == "Ünïcode – 日本 ×", "svg_text preserves Unicode")
+    check(report.svg_text("&amp;") == "&amp;amp;", "svg_text escapes once (pre-escaped text is kept literal)")
+    check(report.svg_text(report.svg_text("<")) == "&amp;lt;", "svg_text applied twice is visibly double escaped")
+
+
+def ordinary_case(tmp):
+    """Ordinary labels render as before: no entities in the text nodes, the same geometry."""
+    panels = [("Launch", "ms", {"pi-bolt": 100.0, "bun": 200.0})]
+    out = tmp / "ordinary.svg"
+    with with_labels({"pi-bolt": "Pi-Bolt", "bun": "Bun 1.4.2"}):
+        report.chart("Time", "Lower is better.", panels, ["pi-bolt", "bun"], "light", out)
+    raw = out.read_text()
+    root = parse(out)
+    check(">Pi-Bolt<" in raw and ">Bun 1.4.2<" in raw, "ordinary: labels are written unchanged")
+    check("&" not in raw, "ordinary: no entities when nothing needs escaping")
+    check(root.get("width") == "880" and root.get("height") == "198",
+          "ordinary: chart geometry unchanged", f"{root.get('width')}x{root.get('height')}")
+    check(root.get("aria-label") == "Time: Lower is better.", "ordinary: aria-label unchanged", root.get("aria-label"))
+
+
+def end_to_end(tmp):
+    """report.py itself, with an adversarial --label, must write SVGs that a standard XML parser accepts."""
+    results, images = tmp / "results", tmp / "images"
+    results.mkdir()
+    rows = []
+    for build in ("pi-bolt", "bun"):
+        for scenario, key in (("interactive", "tti_ms"), ("startup", "wall_ms"), ("headless", "wall_ms")):
+            rows.append({"build": build, "scenario": scenario, "ok": True, "tti_ms": 1.0, "wall_ms": 2.0, "cpu_ms": 3.0,
+                         "peak_mb": 4.0, "peak_fp_mb": 4.5})
+        with (results / "long.jsonl").open("a") as f:
+            f.write(json.dumps({"build": build, "prompt": 1, "ms_per_prompt": 1.0, "cpu_ms_per_prompt": 1.0,
+                                "own_mb": 3.0, "exit": 0, "tokens_m": 4.2}) + "\n")
+        with (results / "tmux.jsonl").open("a") as f:
+            f.write(json.dumps({"build": build, "terminal": "tmux", "prompt_cpu_ms": 1.0, "frame_ms_p99": 1.0,
+                                "memory_at_end": {"own": 3.0}}) + "\n")
+    (results / "benchmark.jsonl").write_text("\n".join(json.dumps(r) for r in rows) + "\n")
+    payload = PAYLOADS[0] + " & \"quoted\" 'single' Ünïcode"
+    p = subprocess.run([sys.executable, str(repo / "bench" / "report.py"), str(results), "--images", str(images),
+                        "--builds", "pi-bolt,bun", "--label", f"bun={payload}"],
+                       capture_output=True, text=True, cwd=repo)
+    check(p.returncode == 0, "end to end: report.py exits 0", p.stderr[-800:])
+    svgs = sorted(images.glob("*.svg"))
+    check(len(svgs) >= 4, "end to end: SVGs were written", str(svgs))
+    for svg in svgs:
+        try:
+            root = parse(svg)
+        except ET.ParseError as e:
+            check(False, f"end to end: {svg.name} parses as XML", str(e))
+            continue
+        ok, detail = assert_safe(root)
+        check(ok, f"end to end: {svg.name} has no injected markup or handlers", str(detail))
+        raw = svg.read_text()
+        check("<script" not in raw and "&amp;amp;" not in raw, f"end to end: {svg.name} has no literal payload or double escaping")
+        check(payload in texts(root), f"end to end: {svg.name} shows the label decoded once")
+
+
+def main():
+    with tempfile.TemporaryDirectory() as d:
+        tmp = Path(d)
+        escape_case()
+        ordinary_case(tmp)
+        chart_case(tmp)
+        hero_case(tmp)
+        end_to_end(tmp)
+    if failures:
+        print(f"\n{len(failures)} failure(s): " + ", ".join(failures))
+        return 1
+    print("\nPASS SVG escaping in bench/report.py")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
