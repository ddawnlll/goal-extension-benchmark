index 000000000..57e322ffa
--- /dev/null
+++ b/bench/test_report.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Regression tests for the SVG escaping in report.py.
+
+Run from the repository root:
+
+    python3 -m unittest discover -s bench -p 'test_report.py' -v
+"""
+
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from xml.etree import ElementTree
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import report  # noqa: E402
+
+SVG = "{http://www.w3.org/2000/svg}"
+TEXT = f"{SVG}text"
+
+
+def svg_text(element):
+    """All text in the element's subtree, as a reader of the rendered chart sees it."""
+    return "".join(element.itertext())
+
+
+def parse(svg):
+    return ElementTree.fromstring(svg)
+
+
+class EscapeTest(unittest.TestCase):
+    def test_metacharacters(self):
+        self.assertEqual(report.esc('&<>"\''), "&amp;&lt;&gt;&quot;&apos;")
+
+    def test_already_escaped_text_is_escaped_once(self):
+        # (A label that reads "&amp;" must render as that literal text, not be decoded or escaped twice.)
+        self.assertEqual(report.esc("&amp;"), "&amp;amp;")
+
+    def test_unicode_preserved(self):
+        text = "Tempo 3× – café 日本 🚀 Ω"
+        self.assertEqual(report.esc(text), text)
+
+    def test_invalid_xml_characters_dropped(self):
+        self.assertEqual(report.esc("a\x00b\ud800c\ufffed"), "abcd")
+        self.assertEqual(report.esc("a\tb\nc\rd"), "a\tb\nc\rd")
+
+
+class SvgTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.dir = Path(self._tmp.name)
+
+    def chart(self, title, subtitle, builds=("pi-bolt", "bun"), panel="Panel"):
+        panels = [(panel, "ms", {b: 10.0 for b in builds}, "time")]
+        path = self.dir / "chart.svg"
+        report.chart(title, subtitle, panels, list(builds), "light", path)
+        return path.read_text(encoding="utf-8")
+
+    def hero(self, title, subtitle, compare, builds=("pi-bolt", "bun"), values=None):
+        values = values or {b: 10.0 for b in builds}
+        tiles = [("Ready", "ms", values, "faster")]
+        path = self.dir / "hero.svg"
+        report.hero(tiles, list(builds), "light", path, title, subtitle, compare=compare)
+        return path.read_text(encoding="utf-8")
+
+    def test_chart_title_subtitle_and_attribute(self):
+        title = '"><script>alert(1)</script>'
+        subtitle = "& < > \" '"
+        panel = "</text><script>alert(2)</script>"
+        root = parse(self.chart(title, subtitle, panel=panel))
+        self.assertIsNone(root.find(f".//{SVG}script"))
+        self.assertEqual(root.get("aria-label"), f"{title}: {subtitle}")
+        rendered = svg_text(root)
+        self.assertIn(title, rendered)
+        self.assertIn(subtitle, rendered)
+        self.assertIn(panel, rendered)
+
+    def test_chart_attribute_breakout(self):
+        title = '" onload="alert(1)'
+        root = parse(self.chart(title, ""))
+        self.assertNotIn("onload", root.attrib)
+        self.assertEqual(root.get("aria-label"), f"{title}: ")
+
+    def test_chart_build_labels(self):
+        builds = ('<script>alert(1)</script>', "bun")
+        root = parse(self.chart("Time", "sub", builds=builds))
+        self.assertIsNone(root.find(f".//{SVG}script"))
+        self.assertIn(builds[0], svg_text(root))
+
+    def test_hero_text_and_compare_name(self):
+        title = "<b>bold</b> & <script>x</script>"
+        subtitle = "café 日本 🚀"
+        name = '"><script>alert(3)</script>'
+        root = parse(self.hero(title, subtitle, [("bun", name)], values={"pi-bolt": 10.0, "bun": 20.0}))
+        self.assertIsNone(root.find(f".//{SVG}script"))
+        self.assertEqual(root.get("aria-label"), title)
+        rendered = svg_text(root)
+        self.assertIn(title, rendered)
+        self.assertIn(subtitle, rendered)
+        self.assertIn(f"2.0× faster than {name}", rendered)
+
+    def test_hero_keeps_unit_tspan(self):
+        root = parse(self.hero("Builds", "sub", [("bun", "Bun")]))
+        self.assertTrue(any(e.tag == f"{SVG}tspan" for e in root.iter()))
+
+    def test_ordinary_output_is_unchanged(self):
+        builds = ["pi-bolt", "bun"]
+
+        def chart_svg():
+            return self.chart("Time", "Wall-clock time, lower is better.", builds=builds)
+
+        def hero_svg():
+            return self.hero("Builds", "A subtitle.", [(b, report.LABELS[b].split()[0]) for b in builds], builds=builds)
+
+        escaped = chart_svg(), hero_svg()
+        plain_esc = report.esc
+        report.esc = lambda text: str(text)  # (what the drawing did before escaping was added)
+        try:
+            unescaped = chart_svg(), hero_svg()
+        finally:
+            report.esc = plain_esc
+        self.assertEqual(escaped, unescaped)
+
+
+if __name__ == "__main__":
+    unittest.main()
