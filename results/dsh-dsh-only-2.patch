+def svg_text(value):
+    """A value made safe to insert into SVG markup, as text content or as a quoted attribute value.
+
+    `&`, `<`, `>` and both quotes become entities, so a label cannot close the element or attribute it sits in, start a
+    script, or add an attribute of its own. Code points XML 1.0 forbids become U+FFFD so the document still parses; every
+    other Unicode character is kept. Call this once per raw value: it never sees its own output, so a label that literally
+    says `&amp;` is escaped to `&amp;amp;` and renders as typed (not double escaping).
+    """
+    return _xml_escape(_XML_INVALID.sub("\ufffd", str(value)), {'"': "&quot;", "'": "&apos;"})
