diff --git a/bench/test_report.py b/bench/test_report.py
new file mode 100644
index 000000000..0de0913da
--- /dev/null
+++ b/bench/test_report.py
@@ -0,0 +1,179 @@
+"""Regression tests for the SVG that bench/report.py draws.
+
+The charts take text from benchmark metadata, labels and --label, so a title, a panel name or a build label is untrusted:
+it must not be able to close an element or an attribute, add one of its own, or start a script. Every document this test
+draws is also parsed by a standard XML parser, which is what a reader's SVG renderer does.
+
+  python3 bench/test_report.py        (or: python3 -m unittest bench.test_report)
+"""
+
+import importlib.util
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+REPORT = Path(__file__).resolve().parent / "report.py"
+SPEC = importlib.util.spec_from_file_location("bench_report", REPORT)
+report = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = report
+SPEC.loader.exec_module(report)
+
+SVGNS = "http://www.w3.org/2000/svg"
+SVG = f"{{{SVGNS}}}svg"
+TEXT = f"{{{SVGNS}}}text"
+HOSTILE = '</text><script>alert(1)</script><text x="0">'
+ATTRIBUTE = '" onload="alert(1)" x="'
+QUOTES = "'\"><script>bad()</script>"
+ORDINARY = "Pi-Bolt, Bun 1.4.2 (×2.9 faster) – 4.2M-token session"
+
+
+def texts(root):
+    """The text of every <text> element in document order, as a parser reads it back."""
+    return [(node.text or "") + "".join(child.text or "" for child in node) for node in root.iter(TEXT)]
+
+
+def draw_chart(tmp, title, subtitle, name, label, payload_build):
+    report.LABELS[payload_build] = label
+    panels = [(name, "ms", {"pi-bolt": 100.0, payload_build: 200.0})]
+    path = Path(tmp) / "chart.svg"
+    report.chart(title, subtitle, panels, ["pi-bolt", payload_build], "light", path)
+    return path
+
+
+class SvgTextTest(unittest.TestCase):
+    def test_escapes_every_xml_special_character(self):
+        self.assertEqual(report.svg_text("a & b"), "a &amp; b")
+        self.assertEqual(report.svg_text("<tag>"), "&lt;tag&gt;")
+        self.assertEqual(report.svg_text('"quoted"'), "&quot;quoted&quot;")
+        self.assertEqual(report.svg_text("it's"), "it&apos;s")
+
+    def test_keeps_legitimate_unicode(self):
+        text = "Pi-Bolt 1.0.0 – 2.9× faster, 4.2M-token session, Ω 日本語 🚀"
+        self.assertEqual(report.svg_text(text), text)
+
+    def test_does_not_double_escape(self):
+        # A label that literally says "&amp;" must render as "&amp;", not "&".
+        self.assertEqual(report.svg_text("&amp;"), "&amp;amp;")
+        self.assertEqual(report.svg_text("&lt;"), "&amp;lt;")
+
+    def test_replaces_characters_xml_forbids(self):
+        for char in ("\x00", "\x08", "\x0b", "\x0c", "\x1f", "\ufffe"):
+            self.assertEqual(report.svg_text(f"a{char}b"), "a\ufffdb", repr(char))
+
+    def test_escaping_is_idempotent_on_parsed_text(self):
+        # What a parser reads back is the original text, so rendering is unchanged for ordinary input.
+        raw = report.svg_text(ORDINARY)
+        root = ET.fromstring(f'<svg xmlns="http://www.w3.org/2000/svg"><text>{raw}</text></svg>')
+        self.assertEqual(texts(root), [ORDINARY])
+
+
+class ChartTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.addCleanup(report.LABELS.pop, "payload-build", None)
+
+    def test_ordinary_chart_is_unchanged(self):
+        path = draw_chart(self.tmp.name, "Time", "Wall-clock time, lower is better.", "Launch", "Bun 1.4.2", "payload-build")
+        root = ET.parse(path).getroot()
+        self.assertEqual(root.tag, SVG)
+        self.assertEqual(root.get("aria-label"), "Time: Wall-clock time, lower is better.")
+        self.assertIn("Time", texts(root))
+        self.assertIn("Launch", texts(root))
+        self.assertIn("Bun 1.4.2", texts(root))
+
+    def test_hostile_chart_parses_and_has_no_injected_markup(self):
+        path = draw_chart(self.tmp.name, HOSTILE, ATTRIBUTE, QUOTES, HOSTILE, "payload-build")
+        root = ET.parse(path).getroot()
+        self.assertEqual(root.tag, SVG)
+        self.assertEqual(root.get("aria-label"), f"{HOSTILE}: {ATTRIBUTE}")
+        self.assertNotIn("onload", root.attrib)
+        self.assertNotIn("script", [node.tag.rsplit("}", 1)[-1] for node in root.iter()])
+        self.assertIn(HOSTILE, texts(root))
+        self.assertIn(QUOTES, texts(root))
+
+
+class HeroTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.addCleanup(report.LABELS.pop, "payload-build", None)
+
+    def draw(self, title, subtitle, name, label):
+        report.LABELS["payload-build"] = label
+        tiles = [(name, "ms", {"pi-bolt": 100.0, "payload-build": 200.0}, "faster")]
+        path = Path(self.tmp.name) / "hero.svg"
+        report.hero(tiles, ["pi-bolt", "payload-build"], "light", path, title, subtitle,
+                   compare=[("payload-build", name)])
+        return path
+
+    def test_ordinary_hero_is_unchanged(self):
+        path = self.draw("Pi-Bolt", "Compared with Bun", "Ready to type", "Bun 1.4.2")
+        root = ET.parse(path).getroot()
+        self.assertEqual(root.get("aria-label"), "Pi-Bolt")
+        self.assertEqual(texts(root), ["Pi-Bolt", "Compared with Bun", "Ready to type", "100ms",
+                                       "2.0× faster than Ready to type", "Pi-Bolt", "100 ms", "Bun 1.4.2", "200 ms"])
+
+    def test_hostile_hero_parses_and_has_no_injected_markup(self):
+        path = self.draw(HOSTILE, ATTRIBUTE, QUOTES, HOSTILE)
+        root = ET.parse(path).getroot()
+        self.assertEqual(root.tag, SVG)
+        self.assertEqual(root.get("aria-label"), HOSTILE)
+        self.assertNotIn("onload", root.attrib)
+        self.assertNotIn("script", [node.tag.rsplit("}", 1)[-1] for node in root.iter()])
+        self.assertIn(HOSTILE, texts(root))
+        self.assertIn(QUOTES, texts(root))
+
+    def test_title_and_subtitle_are_escaped_in_attributes(self):
+        path = self.draw(QUOTES, "", QUOTES, QUOTES)
+        root = ET.parse(path).getroot()
+        self.assertEqual(root.get("aria-label"), QUOTES)
+        self.assertEqual(root.attrib["role"], "img")
+
+
+class CliTest(unittest.TestCase):
+    """The --label path end to end: the text a caller passes on the command line reaches the SVGs."""
+
+    def test_hostile_label_cannot_inject_markup(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            results, images = Path(tmp) / "results", Path(tmp) / "images"
+            results.mkdir()
+            rows = [
+                {"build": build, "scenario": scenario, "ok": True,
+                 "tti_ms": 100.0, "wall_ms": 200.0, "cpu_ms": 300.0, "peak_mb": 50.0, "peak_own_mb": 40.0}
+                for build in ("pi-bolt", "bun", "node") for scenario in ("interactive", "startup", "headless")
+            ]
+            (results / "benchmark.jsonl").write_text("\n".join(json.dumps(row) for row in rows) + "\n")
+            # (The hero's streaming tile reads tmux.jsonl: one row per build is enough for the chart to draw.)
+            tmux = [{"build": build, "terminal": "tmux", "prompt_cpu_ms": 10.0, "memory_at_end": {"own": 20.0}}
+                    for build in ("pi-bolt", "bun", "node")]
+            (results / "tmux.jsonl").write_text("\n".join(json.dumps(row) for row in tmux) + "\n")
+            # (The hero's long-session tile reads long.jsonl.)
+            long = [{"build": build, "prompt": 1, "ms_per_prompt": 5.0, "cpu_ms_per_prompt": 2.0, "own_mb": 30.0}
+                    for build in ("pi-bolt", "bun", "node")]
+            (results / "long.jsonl").write_text("\n".join(json.dumps(row) for row in long) + "\n")
+            subprocess.run([sys.executable, str(REPORT), str(results), "--images", str(images),
+                            "--builds", "pi-bolt,bun,node", "--label", f"bun={HOSTILE}",
+                            "--label", f"node={ORDINARY}", "--label", "pi-bolt=Pi\x0bBolt"],
+                           check=True, capture_output=True)
+            files = sorted(images.glob("*.svg"))
+            self.assertTrue(files)
+            seen = []
+            for path in files:
+                root = ET.parse(path).getroot()
+                self.assertNotIn("script", [node.tag.rsplit("}", 1)[-1] for node in root.iter()])
+                self.assertNotIn("onload", root.attrib)
+                seen += texts(root)
+            self.assertIn(HOSTILE, seen)
+            self.assertIn(ORDINARY, seen)
+            # A control character XML forbids is replaced, so the document still parses.
+            self.assertIn("Pi\ufffdBolt", seen)
+            self.assertNotIn("Pi\x0bBolt", seen)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
