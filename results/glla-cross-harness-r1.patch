index 000000000..2ad2f5cdb
--- /dev/null
+++ b/tests/bench/report-svg.py
@@ -0,0 +1,247 @@
+"""The SVGs bench/report.py draws stay well-formed, and a label cannot become markup.
+
+Every chart shows text the tool did not write itself: a build's name and --label's text from the command line, a panel's name
+from a results file (pauses.jsonl's step), a version from environment.txt. Each is escaped where it is written, once, so a
+label cannot close a text element, end an attribute or open a script, and characters XML 1.0 forbids are removed rather than
+written. Ordinary text is not touched: the same runs draw the same bytes as before.
+
+  python3 tests/bench/report-svg.py           (tests/bench/run.sh runs this)
+
+Standard library only: unittest, and xml.etree.ElementTree as the reference parser (a document that parses there is well-formed).
+The end-to-end case runs report.py as the user does, against a copy of a results folder in a temporary directory, so
+bench/results is never written.
+"""
+import importlib.util
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+REPORT = ROOT / "bench" / "report.py"
+SVG = "{http://www.w3.org/2000/svg}"
+
+spec = importlib.util.spec_from_file_location("bench_report", REPORT)
+report = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(report)
+
+PANELS = [("Launch to interactive (TUI)", "ms", {"pi-bolt": 41.0, "bun": 100.0}), ("pi --version", "ms", {"pi-bolt": 9.0, "bun": 30.0})]
+TILES = [("Ready to type", "ms", {"pi-bolt": 41.0, "bun": 100.0}, "faster"), ("CPU per session", "ms", {"pi-bolt": 139.0, "bun": 561.0}, "less")]
+
+
+class SvgCase(unittest.TestCase):
+    """A mixin: draw with report.py's own writers into a temporary file and hand back the text and the parsed root."""
+
+    def setUp(self):
+        self.dir = Path(tempfile.mkdtemp(prefix="report-svg-"))
+        self.labels = dict(report.LABELS)
+        self.addCleanup(shutil.rmtree, self.dir, True)
+        self.addCleanup(self.restore_labels)
+
+    def restore_labels(self):
+        report.LABELS.clear()
+        report.LABELS.update(self.labels)
+
+    def chart(self, title="Time", subtitle="Lower is better.", panels=PANELS, builds=("pi-bolt", "bun")):
+        path = self.dir / "chart.svg"
+        report.chart(title, subtitle, panels, list(builds), "light", path)
+        return path.read_text(encoding="utf-8")
+
+    def hero(self, title="Pi-Bolt", subtitle="Lower is better.", tiles=TILES, builds=("pi-bolt", "bun")):
+        path = self.dir / "hero.svg"
+        report.hero(tiles, list(builds), "light", path, title, subtitle)
+        return path.read_text(encoding="utf-8")
+
+    def root(self, text):
+        """The document as a standard XML parser reads it: anything unparseable fails the test by raising."""
+        return ET.fromstring(text)
+
+    def texts(self, root):
+        return [e.text or "" for e in root.iter(SVG + "text")]
+
+
+class TestEscaping(SvgCase):
+    """The helper itself: what is replaced, what is kept, and what is removed."""
+
+    def test_text_node_entities(self):
+        self.assertEqual(report.svg_text("a & b < c > d"), "a &amp; b &lt; c &gt; d")
+        # (A quote needs no escaping between tags, and is left readable there.)
+        self.assertEqual(report.svg_text("""He said "hi" it's"""), """He said "hi" it's""")
+
+    def test_attribute_entities(self):
+        self.assertEqual(report.svg_attr("""a & b < c > d "e" 'f'"""), "a &amp; b &lt; c &gt; d &quot;e&quot; &apos;f&apos;")
+
+    def test_ordinary_text_is_untouched(self):
+        for ordinary in ("Pi-Bolt 1.1.0", "Bun 1.4.2", "Node 26", "Time", "pi -p: one prompt, 4 tool calls"):
+            self.assertEqual(report.svg_text(ordinary), ordinary)
+            self.assertEqual(report.svg_attr(ordinary), ordinary)
+
+    def test_encodes_once(self):
+        # A value that already looks escaped is text, not an entity to honour: it is escaped exactly once, here.
+        self.assertEqual(report.svg_text("&amp;"), "&amp;amp;")
+        self.assertEqual(report.svg_text(report.svg_text("&")), "&amp;amp;")
+
+    def test_unicode_preserved(self):
+        for text in ("Café Münster", "\u4e2d\u6587\u6807\u7b7e", "\U0001f680 fast", "\u05e2\u05d1\u05e8\u05d9\u05ea"):
+            self.assertEqual(report.svg_text(text), text)
+            self.assertEqual(report.svg_attr(text), text)
+
+    def test_illegal_characters_removed(self):
+        # XML 1.0 has no way to hold these, even escaped: one would make the whole document unparseable.
+        dirty = "a\x00b\x07c\x0bd\x0ce\x1ff\ud800g\ufffeh"
+        self.assertEqual(report.svg_text(dirty), "abcdefgh")
+        self.assertEqual(report.svg_attr(dirty), "abcdefgh")
+        # (Tab, newline and carriage return are legal, and stay.)
+        self.assertEqual(report.svg_text("a\tb\nc\rd"), "a\tb\nc\rd")
+
+
+class TestTextNodes(SvgCase):
+    """Text that comes from outside cannot become an element."""
+
+    def test_panel_name_injection(self):
+        name = "<script>alert(1)</script>"
+        root = self.root(self.chart(panels=[(name, "ms", {"pi-bolt": 1.0, "bun": 2.0})]))
+        self.assertEqual([e for e in root.iter(SVG + "script")], [])
+        self.assertIn(name, self.texts(root))  # it reads as the text the label was
+
+    def test_label_injection_in_both_writers(self):
+        payload = "<img src=x onerror=alert(1)>"
+        report.LABELS["bun"] = payload
+        for text in (self.chart(), self.hero()):
+            root = self.root(text)
+            self.assertEqual([e for e in root.iter(SVG + "img")], [])
+            self.assertEqual([a for e in root.iter() for a in e.attrib if "onerror" in a], [])
+            self.assertIn(payload, self.texts(root))
+
+    def test_entity_label_reads_back(self):
+        # "A & B" is escaped in the file and decodes to itself: one escape, no double.
+        report.LABELS["bun"] = "Bun & Node <both>"
+        text = self.chart()
+        self.assertIn("Bun &amp; Node &lt;both&gt;", text)
+        self.assertIn("Bun & Node <both>", self.texts(self.root(text)))
+
+    def test_style_font_family_injection(self):
+        # The font stack sits in a <style> element: a value that closes it would add markup of its own.
+        font = report.FONT
+        payload = "</style><script>alert(1)</script>"
+        report.FONT = payload
+        self.addCleanup(setattr, report, "FONT", font)
+        text = self.chart()
+        root = self.root(text)
+        self.assertEqual([e for e in root.iter(SVG + "script")], [])
+        self.assertEqual(len([e for e in root.iter(SVG + "style")]), 1)
+        self.assertIn("&lt;/style&gt;&lt;script&gt;", text)
+        self.assertEqual("".join(e.text or "" for e in root.iter(SVG + "style")), f"text{{font-family:{payload}}}")
+        report.FONT = font
+
+
+class TestAttributes(SvgCase):
+    """The title and subtitle also go into aria-label, where a quote could end the value."""
+
+    def test_quote_cannot_end_the_attribute(self):
+        title = 'Time" onload="alert(1)'
+        root = self.root(self.chart(title=title, subtitle='a " b'))
+        el = root
+        self.assertEqual(el.get("aria-label"), f'{title}: a " b')
+        self.assertEqual([k for k in el.attrib if k.startswith("on")], [])
+
+    def test_hero_aria_label_default_and_given(self):
+        self.assertEqual(self.root(self.hero(title=None)).get("aria-label"), "Pi-Bolt compared with Bun and Node")
+        self.assertEqual(self.root(self.hero(title='A "B" <C>')).get("aria-label"), 'A "B" <C>')
+
+    def test_element_injection_in_attribute(self):
+        root = self.root(self.chart(subtitle='"><script>alert(1)</script>'))
+        self.assertEqual([e for e in root.iter(SVG + "script")], [])
+        self.assertEqual(root.get("aria-label"), 'Time: "><script>alert(1)</script>')
+
+
+class TestDocumentsParse(SvgCase):
+    """Every writer's output, ordinary or hostile, is a document a standard parser accepts."""
+
+    def test_ordinary_documents(self):
+        for text in (self.chart(), self.hero()):
+            root = self.root(text)
+            self.assertEqual(root.tag, SVG + "svg")
+            self.assertTrue(root.get("aria-label"))
+
+    def test_hostile_documents(self):
+        report.LABELS["bun"] = '"><script>x</script>&\x00'
+        hostile = self.chart(title="<Time>", subtitle="A & B", panels=[("C < D & E", "ms", {"pi-bolt": 1.0, "bun": 2.0})])
+        root = self.root(hostile)
+        self.assertEqual(root.tag, SVG + "svg")
+        self.assertEqual({e.tag for e in root.iter()}, {SVG + t for t in ("svg", "style", "text", "path", "line")})
+
+
+class TestReportRun(unittest.TestCase):
+    """report.py as the user runs it: hostile labels from the command line, a copy of a results folder, all SVGs parsed."""
+
+    def setUp(self):
+        self.dir = Path(tempfile.mkdtemp(prefix="report-svg-run-"))
+        self.addCleanup(shutil.rmtree, self.dir, True)
+
+    def run_report(self, dataset, *extra):
+        results = self.dir / "results"
+        if not results.exists():
+            shutil.copytree(ROOT / "bench" / "results" / dataset, results)
+        images = self.dir / "images"
+        return subprocess.run(
+            [sys.executable, str(REPORT), str(results), "--images", str(images), *extra],
+            capture_output=True, text=True, cwd=str(ROOT),
+        )
+
+    def svgs(self):
+        return sorted((self.dir / "images").glob("*.svg"))
+
+    def test_hostile_command_line(self):
+        done = self.run_report("2026-10-11-linux-x64-0.8.0", "--builds", "pi-bolt,<img src=x onerror=alert(1)>,node",
+                               "--label", 'node="><script>alert(1)</script>')
+        self.assertEqual(done.returncode, 0, done.stderr)
