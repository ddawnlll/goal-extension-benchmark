+def esc(value):
+    """Text for SVG markup: XML-escaped once, quotes too (text nodes and assembled attributes both go through it).
+
+    Labels can come from CLI flags, environment.txt and the JSONL results, so they are untrusted: escaping here, at the
+    insertion point, keeps them from closing a text node or an attribute and adding elements or scripts. The value itself
+    stays unescaped everywhere else (text measurement, ratios), so nothing is escaped twice."""
+    return html.escape(str(value), quote=True)
+
