index 000000000..88301e45a
--- /dev/null
+++ b/bench/test_report.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""Regression tests for the SVG that bench/report.py draws: escaping, validity, and unchanged drawings.
+
+Run from the repository root: python3 -m unittest bench/test_report.py
+
+Labels come from --builds, --label, environment.txt and the JSONL results, so they are untrusted: every one of them must be
+escaped where it enters the SVG, and the document must still parse as XML. The baselines below were taken from the version of
+bench/report.py before escaping was added (git HEAD when the fix landed): ordinary input must draw the same bytes as before.
+"""
+
+import hashlib
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import report  # noqa: E402
+
+SVG = "{http://www.w3.org/2000/svg}"
+# What chart() and hero() draw: an injected <script>, <foreignObject> or stray attribute would show up here.
+ALLOWED_TAGS = {SVG + name for name in ("svg", "style", "text", "tspan", "path", "line", "rect")}
+# A label that closes the text node and the aria-label attribute, injects an element with an attribute and more text, and
+# carries every character that XML wants escaped.
+PAYLOAD = 'x"><script>alert(1)</script>&<b a="y">\'z\''
+
+CHART = dict(
+    title="Time",
+    subtitle="Wall-clock time, lower is better. Ratios compare Pi-Bolt with Bun. Pi 1.0.0, medians.",
+    panels=[("Launch to interactive (TUI)", "ms", {"pi-bolt": 120.0, "bun": 300.0, "node": 450.0}, "time"),
+            ("pi --version", "ms", {"pi-bolt": 30.0, "bun": 40.0, "node": 55.0}, "time")],
+    builds=["pi-bolt", "bun", "node"],
+    theme="light",
+)
+HERO = dict(
+    title="Long answers and large files",
+    subtitle="Answers streamed at 1,200 characters a second; a file written through a tool call. Lower is better.",
+    tiles=[("Ready to type", "ms", {"pi-bolt": 120.0, "bun": 300.0, "node": 450.0}, "faster"),
+           ("CPU per session", "ms", {"pi-bolt": 900.0, "bun": 1500.0, "node": 2100.0}, "less")],
+    builds=["pi-bolt", "bun", "node"],
+    theme="dark",
+)
+UNICODE = dict(
+    title="Pi 0.7.3 – time × 2",
+    subtitle="Medians, 日本語 and 🙂 labels, café.",
+    panels=[("CPU, 20,000-char answer", "s", {"pi-bolt": 1.5, "bun": 2.5}, "less")],
+    builds=["pi-bolt", "bun"],
+    theme="light",
+)
+# sha256 of the SVGs drawn by the pre-escaping bench/report.py for the three inputs above.
+BASELINES = {
+    "chart": "dc06e82b6b5c5bd5cf84ddc8b883d490122bd80833c0df9da06febdf86e9f95d",
+    "hero": "8fc794bc5af433e55f4af860f96885829baa3efa8e140fdc66bd292a953d77f9",
+    "unicode": "cd5f0973e1eb84927d984675b2d072380501dedd80e864dc52146813fb6d0752",
+}
+
+
+class SvgTestCase(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.dir = Path(self._dir.name)
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def draw(self, fn, name, **kwargs):
+        path = self.dir / f"{name}.svg"
+        fn(path=path, **kwargs)
+        return path.read_text(encoding="utf-8")
+
+
+class ValidityTests(SvgTestCase):
+    def test_chart_is_well_formed_xml(self):
+        for theme in ("light", "dark"):
+            text = self.draw(report.chart, f"chart-{theme}", **{**CHART, "theme": theme})
+            self.assertEqual(ET.fromstring(text).tag, SVG + "svg")
+
+    def test_hero_is_well_formed_xml(self):
+        for theme in ("light", "dark"):
+            text = self.draw(report.hero, f"hero-{theme}", **{**HERO, "theme": theme})
+            self.assertEqual(ET.fromstring(text).tag, SVG + "svg")
+
+    def test_ordinary_drawings_are_byte_identical_to_the_baseline(self):
+        # Escaping is the identity on input with no XML special characters: the images must look exactly as before.
+        for name, fn, kwargs in (("chart", report.chart, CHART), ("hero", report.hero, HERO), ("unicode", report.chart, UNICODE)):
+            text = self.draw(fn, name, **kwargs)
+            self.assertEqual(hashlib.sha256(text.encode("utf-8")).hexdigest(), BASELINES[name], name)
+
+
+class EscapingTests(SvgTestCase):
+    def test_chart_escapes_text_and_aria_label(self):
+        chart = {**CHART, "title": PAYLOAD, "subtitle": PAYLOAD,
+                 "panels": [("Panel " + PAYLOAD, "ms", {"pi-bolt": 120.0, PAYLOAD: 300.0}, "time")],
+                 "builds": ["pi-bolt", PAYLOAD]}
+        text = self.draw(report.chart, "adversarial-chart", **chart)
+        root = ET.fromstring(text)
+
+        texts = [el.text for el in root.iter(SVG + "text")]
+        self.assertEqual(root.get("aria-label"), f"{PAYLOAD}: {PAYLOAD}")
+        self.assertIn(PAYLOAD, texts)  # build label and the ratio note that names the other build
+        self.assertIn("Panel " + PAYLOAD, texts)
+        self.assert_no_injection(text, root)
+
+    def test_hero_escapes_text_and_composed_tspan(self):
+        unit = 'ms"&<x>'
+        tiles = [("Tile " + PAYLOAD, unit, {"pi-bolt": 120.0, "bun": 300.0}, "faster")]
+        text = self.draw(report.hero, "adversarial-hero", title=PAYLOAD, subtitle=PAYLOAD, tiles=tiles,
+                         builds=["pi-bolt", PAYLOAD], theme="dark")
+        root = ET.fromstring(text)
+
+        texts = [el.text for el in root.iter(SVG + "text")]
+        self.assertEqual(root.get("aria-label"), PAYLOAD)
+        self.assertIn(PAYLOAD, texts)  # title, subtitle, build label
+        self.assertIn("Tile " + PAYLOAD, texts)
+        # The large figure's unit sits in a tspan the chart composes itself: its text is escaped, the <tspan> is not.
+        self.assertEqual([el.text for el in root.iter(SVG + "tspan")], [unit])
+        self.assert_no_injection(text, root)
+
+    def test_no_double_escaping(self):
+        for already in ("&amp;", "&lt;", "&#x27;", "a & b"):
+            text = self.draw(report.chart, "double", **{**CHART, "title": already})
+            # The raw markup escapes the ampersand of an entity-looking label exactly once...
+            self.assertIn(report.esc(already), text)
+            # ...and a parser gives the label back unchanged.
+            self.assertEqual(ET.fromstring(text).find(SVG + "text").text, already)
+
+    def test_entity_like_label_is_escaped_once(self):
+        text = self.draw(report.chart, "entity", **{**CHART, "title": "&amp;"})
+        self.assertIn("&amp;amp;", text)
+        self.assertNotIn("&amp;&amp;", text)
+
+    def test_special_characters_are_escaped_in_both_contexts(self):
+        title = "& < > \" '"
+        text = self.draw(report.chart, "chars", **{**CHART, "title": title})
+        self.assertIn("&amp; &lt; &gt; &quot; &#x27;", text)
+        root = ET.fromstring(text)
+        self.assertEqual(root.get("aria-label"), f"{title}: {CHART['subtitle']}")
+        self.assertEqual(root.find(SVG + "text").text, title)
+
+    def test_unicode_is_preserved_as_characters(self):
+        labels = ["×", "–", "日本語", "🙂", "café", "Ω"]
+        for label in labels:
+            text = self.draw(report.chart, "unicode-label", **{**CHART, "title": label})
+            self.assertIn(label, text)  # (not escaped into numeric references)
+            self.assertEqual(ET.fromstring(text).find(SVG + "text").text, label)
+
+    def assert_no_injection(self, text, root):
+        self.assertNotIn("<script", text)
+        self.assertNotIn("onload", text)
+        self.assertNotIn("<b ", text)
+        for el in root.iter():
+            self.assertIn(el.tag, ALLOWED_TAGS)
+            for name in el.attrib:
+                self.assertFalse(name.lower().startswith("on"), name)
+
+
+if __name__ == "__main__":
+    unittest.main()
