+# What an XML document may contain at all (XML 1.0, the Char production): tab, line feed, carriage return, U+0020 to U+D7FF,
+# U+E000 to U+FFFD, and U+10000 up. Anything else - the other C0 controls, a lone surrogate from a JSON escape, U+FFFE, U+FFFF -
+# makes the document unparseable, whoever wrote the label.
+NOT_XML = re.compile("[^\t\n\r\u0020-\ud7ff\ue000-\ufffd\U00010000-\U0010ffff]")
+
+
+def esc(text):
+    """Text to put into an SVG document: characters XML forbids become U+FFFD, then &, <, >, " and ' are escaped once.
+
+    Applied where a value is written into the markup, and nowhere else: labels, build ids, plugin and step names, figures and
+    notes may come from a results folder or --label and --builds, so an unescaped one could close a <text> or the aria-label
+    attribute and open elements or attributes of its own. Escaping only here - never before a value is measured by
+    text_width - keeps the layout (and so the charts of ordinary labels) as it was, and rules out double escaping.
+    """
+    return html.escape(NOT_XML.sub("\ufffd", str(text)), quote=True)
 
 
