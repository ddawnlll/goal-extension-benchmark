+#!/usr/bin/env python3
+"""Tests for what bench/report.py writes into its SVG charts.
+
+Every label, build id, panel name, plugin name, step name and note a chart draws can come from a results folder, --label or
+--builds, so three things are checked here: the escaping rule itself (special characters escaped once, legitimate Unicode kept,
+characters XML forbids replaced), that no label can add an element or attribute to a document, and that ordinary labels still
+produce the charts they did (untouched text, unchanged geometry).
+
+Run: python3 bench/test_report_svg.py     (standard library only)
+"""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+BENCH = Path(__file__).resolve().parent
+REPORT = BENCH / "report.py"
+NS = "{http://www.w3.org/2000/svg}"
+SVG = NS + "svg"
+ROOT_ATTRS = {"width", "height", "viewBox", "role", "aria-label"}
+
+sys.path.insert(0, str(BENCH))
+import report  # noqa: E402  (after the path, and the reason for it)
+
+HOSTILE = [
+    '"><script>alert(1)</script>',
+    "<script>alert(1)</script>",
+    "a & b",
+    "' onload='alert(1)",
+    "x\x01y",
+    "\ud800",
+    "Ünïcødé 日本語 😀",
+]
+
+
+def kept(text):
+    """What a label reads as in the document: characters XML forbids become U+FFFD, the rest is the text itself."""
+    return report.NOT_XML.sub("\ufffd", text)
+
+
+def parse(path):
+    return ET.parse(path).getroot()
+
+
+class EscTest(unittest.TestCase):
+    def test_special_characters_escaped(self):
+        self.assertEqual(report.esc('a & b <c> "d" \'e\''), "a &amp; b &lt;c&gt; &quot;d&quot; &#x27;e&#x27;")
+
+    def test_unicode_preserved(self):
+        for text in ("Ünïcødé", "日本語", "😀", "עברית", "tab\there\nnewline"):
+            self.assertEqual(report.esc(text), text)
+
+    def test_characters_xml_forbids_become_replacement_characters(self):
+        for bad in ("\x00", "\x01", "\x0b", "\x0c", "\x1f", "\ufffe", "\uffff", "\ud800", "\udfff"):
+            self.assertEqual(report.esc(f"a{bad}b"), "a\ufffdb", repr(bad))
+
+    def test_escaped_once_only(self):
+        self.assertEqual(report.esc("<"), "&lt;")
+        self.assertNotIn("&amp;lt;", report.esc("<"))
+        self.assertEqual(report.esc("&amp;"), "&amp;amp;")  # the label's own text, escaped once (not an escape to re-run)
+        self.assertEqual(report.esc(3), "3")
+
+
+class ChartTest(unittest.TestCase):
+    def chart(self, title, subtitle, panels, builds):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "chart.svg"
+            report.chart(title, subtitle, panels, builds, "light", path)
+            return path.read_text(encoding="utf-8"), parse(path)
+
+    def test_no_label_adds_an_element_or_attribute(self):
+        for text in HOSTILE:
+            panels = [("Panel " + text, "ms", {"pi-bolt": 5.0, "bun": 10.0}, "time")]
+            raw, root = self.chart(text, text, panels, ["pi-bolt", text])
+            self.assertEqual(root.tag, SVG, text)
+            self.assertEqual(set(root.attrib), ROOT_ATTRS, text)
+            self.assertNotIn("script", [e.tag.split("}")[-1] for e in root.iter()], text)
+            self.assertNotIn("<script", raw, text)
+            self.assertEqual(root.get("aria-label"), f"{kept(text)}: {kept(text)}", text)
+
+    def test_label_text_survives_as_text(self):
+        for text in HOSTILE:
+            panels = [("Panel " + text, "ms", {"pi-bolt": 5.0, "bun": 10.0}, "time")]
+            _, root = self.chart(text, text, panels, ["pi-bolt", text])
+            texts = [t.text or "" for t in root.iter(NS + "text")]
+            self.assertIn(kept(text), texts, text)  # the title, once, verbatim
+            self.assertIn("Panel " + kept(text), texts, text)  # a panel name
+            self.assertIn(kept(text), [t.text or "" for t in root.iter(NS + "text")][-2:], text)  # the build's own label
+
+    def test_ordinary_labels_unchanged(self):
+        panels = [("Launch to interactive (TUI)", "ms", {"pi-bolt": 41.2, "bun": 63.0}, "time")]
+        raw, root = self.chart("Time", "Wall-clock time, lower is better.", panels, ["pi-bolt", "bun"])
+        texts = [t.text or "" for t in root.iter(NS + "text")]
+        self.assertIn("Launch to interactive (TUI)", texts)
+        self.assertIn("41 ms", texts)
+        self.assertIn("1.5× faster", texts)  # the ratio note, which is generated text like any other
+        self.assertNotIn("&amp;", raw)
+        self.assertNotIn("\ufffd", raw)
+        self.assertEqual(root.get("aria-label"), "Time: Wall-clock time, lower is better.")
+        self.assertEqual(root.get("width"), "880")
+
+
+class HeroTest(unittest.TestCase):
+    def hero(self, title, subtitle, name, builds, compare):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "hero.svg"
+            tiles = [(name, "ms", {builds[0]: 5.0, builds[1]: 10.0}, "faster")]
+            report.hero(tiles, builds, "dark", path, title, subtitle, compare)
+            return path.read_text(encoding="utf-8"), parse(path)
+
+    def test_no_label_adds_an_element_or_attribute(self):
+        for text in HOSTILE:
+            raw, root = self.hero(text, text, "Tile " + text, ["pi-bolt", text], [(text, text)])
+            self.assertEqual(root.tag, SVG, text)
+            self.assertEqual(set(root.attrib), ROOT_ATTRS, text)
+            self.assertNotIn("<script", raw, text)
+            self.assertEqual(root.get("aria-label"), kept(text), text)
+            texts = [t.text or "" for t in root.iter(NS + "text")]
+            self.assertIn("Tile " + kept(text), texts, text)
+            self.assertIn(kept(text), texts, text)  # the figure's build label and the compared line
+
+    def test_ordinary_labels_unchanged(self):
+        raw, root = self.hero("Headline", "Lower is better.", "Ready to type", ["pi-bolt", "bun"],
+                              [("bun", "Bun")])
+        texts = [t.text or "" for t in root.iter(NS + "text")]
+        self.assertIn("Ready to type", texts)
+        self.assertIn("2.0× faster than Bun", texts)
+        self.assertIn("Pi-Bolt", texts)
+        self.assertNotIn("&amp;", raw)
+        self.assertEqual(root.get("aria-label"), "Headline")
+
+
+class ReportTest(unittest.TestCase):
+    """bench/report.py end to end, over a small results folder of its own (no benchmark dataset is read or written)."""
+
+    def fixture(self, root):
+        (root / "environment.txt").write_text("pi-bolt: 1.0.0 (Pi-Bolt 0.0.0, linux-x64, JIT off)\nbun: 1.4.2\n", encoding="utf-8")
+        rows = []
+        for build, scale in (("pi-bolt", 1), ("bun", 2)):
+            for scenario, keys in (("startup", ["wall_ms", "cpu_ms"]), ("headless", ["wall_ms", "cpu_ms"]),
+                                   ("interactive", ["tti_ms", "cpu_ms", "peak_mb", "peak_fp_mb"])):
+                row = {"build": build, "scenario": scenario, "ok": True}
+                row.update({k: 10 * scale for k in keys})
+                rows.append(row)
+        (root / "benchmark.jsonl").write_text("\n".join(json.dumps(r) for r in rows) + "\n", encoding="utf-8")
+        (root / "tmux.jsonl").write_text("\n".join(json.dumps(
+            {"build": b, "prompt_cpu_ms": 100, "frame_ms_p99": 12, "memory_at_end": {"own": 50}}) for b in ("pi-bolt", "bun")
+        ) + "\n", encoding="utf-8")
+        (root / "long.jsonl").write_text("\n".join(json.dumps(
+            {"build": b, "prompt": 20, "ms_per_prompt": 900, "cpu_ms_per_prompt": 400, "own_mb": 60, "tokens_m": 4.2})
+            for b in ("pi-bolt", "bun")) + "\n", encoding="utf-8")
+        (root / "plugins.jsonl").write_text("\n".join(json.dumps(
+            {"build": "pi-bolt", "plugin": plugin, "loop_ms": [8, 9, 10], "launch_ms": 120})
+            for plugin in ("compiled", 'compiled"><script>alert(1)</script>')) + "\n", encoding="utf-8")
+        (root / "pauses.jsonl").write_text(json.dumps(
+            {"build": "pi-bolt", "step": 'write:200"><script>alert(1)</script>', "gc_logged": False,
+             "frame_ms_p99": 9, "longest_ms": 40}) + "\n", encoding="utf-8")
+
+    def run_report(self, root, images, *labels):
+        cmd = [sys.executable, str(REPORT), str(root), "--images", str(images), "--builds", "pi-bolt,bun"]
+        for label in labels:
+            cmd += ["--label", label]
+        return subprocess.run(cmd, capture_output=True, text=True)
+
+    def test_hostile_labels_and_metadata_stay_text(self):
+        with tempfile.TemporaryDirectory() as d:
+            root = Path(d) / "results"
+            root.mkdir()
+            self.fixture(root)
+            for label, expected in (
+                ('bun=Bad"><script>alert(1)</script>', "&quot;&gt;&lt;script&gt;alert(1)&lt;/script&gt;"),
+                ("bun=A & B", "A &amp; B"),  # escaped once...
+            ):
+                images = Path(d) / ("images-" + str(abs(hash(label))))
+                done = self.run_report(root, images, label)
+                self.assertEqual(done.returncode, 0, done.stderr)
+                charts = sorted(images.glob("*.svg"))
+                self.assertTrue(charts, "no charts were written")
+                for path in charts:
+                    raw = path.read_text(encoding="utf-8")
+                    root_el = parse(path)  # a standard XML parser accepts it, as one SVG document
+                    self.assertEqual(root_el.tag, SVG, path.name)
+                    self.assertEqual(set(root_el.attrib), ROOT_ATTRS, path.name)
+                    self.assertNotIn("<script", raw, path.name)
+                    self.assertNotIn("\ufffd", raw, path.name)
