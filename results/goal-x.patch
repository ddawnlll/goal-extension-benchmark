+#!/usr/bin/env python3
+"""Tests for bench/report.py's SVG output: the markup is well formed, and no label, title or step name can leave it.
+
+Run from the repository root:
+  python3 bench/test_report.py
+  python3 -m unittest discover -s bench -p "test_*.py"
+"""
+
+import contextlib
+import io
+import json
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))  # (bench/ is no package: report.py lies next to this file)
+import report  # noqa: E402
+
+SVG = "{http://www.w3.org/2000/svg}"
+# What a chart is made of: the elements and attributes the report itself writes.
+ELEMENTS = {"svg", "style", "text", "tspan", "path", "line", "rect"}
+ATTRIBUTES = {"xmlns", "width", "height", "viewBox", "role", "aria-label", "x", "y", "font-size", "font-weight", "fill",
+              "text-anchor", "d", "dx", "x1", "x2", "y1", "y2", "stroke", "rx"}
+# An ordinary figure, as the charts hold them: a build and a value to compare it with.
+PANELS = [("Launch to interactive (TUI)", "ms", {"pi-bolt": 412.0, "bun": 1196.0}),
+          ("pi --version", "ms", {"pi-bolt": 31.0, "bun": 62.0})]
+TILES = [("Ready to type", "ms", {"pi-bolt": 412.0, "bun": 1196.0}, "faster"),
+         ("CPU per session", "ms", {"pi-bolt": 900.0, "bun": 2400.0}, "less")]
+PAYLOADS = [
+    '</text><script>alert(1)</script>',
+    '"><script>alert(1)</script>',
+    '" onmouseover="alert(1)',
+    "' onload='alert(1)",
+    '<rect x="0" y="0" width="10" height="10"/>',
+    ']]><script>x</script>',
+    '<style>*{fill:red}</style>',
+    '&lt;script&gt;alert(1)&lt;/script&gt;',  # (already escaped: escaped again, and still drawn as text)
+]
+
+
+def text_of(path):
+    """Every <text> and <tspan> in the document, as a reader of the picture sees it."""
+    root = ET.parse(path).getroot()
+    return ["".join(e.itertext()) for e in root.iter() if e.tag in (SVG + "text", SVG + "tspan")]
+
+
+def local_names(root):
+    return {e.tag.rsplit("}", 1)[-1] for e in root.iter()}
+
+
+def attribute_names(root):
+    return {k.rsplit("}", 1)[-1] for e in root.iter() for k in e.attrib}
+
+
+class SvgTest(unittest.TestCase):
+    def setUp(self):
+        self.labels = dict(report.LABELS)
+        self.version = list(report.PI_VERSION)
+        self.tmp = tempfile.TemporaryDirectory()
+        self.dir = Path(self.tmp.name)
+        self.written = 0
+
+    def tearDown(self):
+        report.LABELS.clear()
+        report.LABELS.update(self.labels)
+        report.PI_VERSION[:] = self.version
+        self.tmp.cleanup()
+
+    def path(self, name, theme):
+        self.written += 1
+        return self.dir / f"{name}-{theme}-{self.written}.svg"
+
+    def chart(self, theme="light", **kw):
+        path = self.path("chart", theme)
+        report.chart(kw.pop("title", "Time"), kw.pop("subtitle", "Wall-clock time, lower is better."),
+                     kw.pop("panels", PANELS), kw.pop("builds", ["pi-bolt", "bun"]), theme, path)
+        return path
+
+    def hero(self, theme="light", **kw):
+        path = self.path("hero", theme)
+        report.hero(kw.pop("tiles", TILES), kw.pop("builds", ["pi-bolt", "bun"]), theme, path, **kw)
+        return path
+
+    def assert_well_formed(self, path):
+        root = ET.parse(path).getroot()  # (a malformed document raises here)
+        self.assertEqual(root.tag, SVG + "svg")
+        # Nothing an input could add: only the elements and attributes this file writes.
+        self.assertEqual(local_names(root) - ELEMENTS, set(), path.read_text()[:400])
+        self.assertEqual(attribute_names(root) - ATTRIBUTES, set(), path.read_text()[:400])
+        return root
+
+    def test_ordinary_charts_are_well_formed(self):
+        for theme in ("light", "dark"):
+            self.assert_well_formed(self.chart(theme))
+            self.assert_well_formed(self.hero(theme))
+        self.assert_well_formed(self.hero("light", title="Long answers and large files", subtitle="Lower is better."))
+
+    def assert_drawn(self, path, text):
+        """The text is in the picture as it was given, in one <text> or <tspan> (not split, not escaped twice)."""
+        self.assertTrue(any(text in t for t in text_of(path)), f"{text!r} is not drawn in {path.name}")
+
+    def test_ordinary_values_are_unchanged(self):
+        chart = text_of(self.chart())
+        self.assertEqual(chart[0], "Time")
+        self.assertEqual(chart[1], "Wall-clock time, lower is better.")
+        self.assertIn("Launch to interactive (TUI)", chart)
+        self.assertIn("412 ms", chart)
+        self.assertIn("1,196 ms", chart)
+        self.assertIn("2.9× faster", chart)  # (1196 / 412)
+        hero = text_of(self.hero())
+        self.assertEqual(hero[0], "Ready to type")
+        self.assertIn("412ms", hero)  # (the figure, then its unit in a tspan)
+        self.assertIn("2.9× faster than Bun", hero)
+
+    def test_special_characters_round_trip(self):
+        label = 'A & B <c> "d" \'e\' >f'
+        report.LABELS["bun"] = label
+        path = self.chart()
+        self.assert_drawn(path, label)
+        self.assert_well_formed(path)
+        # Escaped once: the entities are in the markup, and nothing is escaped a second time.
+        raw = path.read_text()
+        self.assertIn("A &amp; B &lt;c&gt; &quot;d&quot; &#39;e&#39; &gt;f", raw)
+        self.assertNotIn("&amp;amp;", raw)
+        self.assertNotIn("&amp;lt;", raw)
+
+    def test_unicode_is_preserved(self):
+        label = "Näive – 日本語 × 🚀 Ω"
+        report.LABELS["bun"] = label
+        path = self.chart(title=f"Time {label}", subtitle=label)
+        self.assert_drawn(path, label)
+        self.assert_drawn(path, f"Time {label}")
+        self.assertIn(label, path.read_text())
+        self.assert_well_formed(path)
+
+    def test_aria_label_is_escaped(self):
+        title, subtitle = 'A "b" <c> & d', "e'f > g"
+        self.assertEqual(self.assert_well_formed(self.chart(title=title, subtitle=subtitle)).get("aria-label"),
+                         f"{title}: {subtitle}")
+        self.assertEqual(self.assert_well_formed(self.hero(title=title, subtitle=subtitle)).get("aria-label"), title)
+
+    def test_labels_cannot_inject_markup(self):
+        for payload in PAYLOADS:
+            with self.subTest(payload=payload):
+                report.LABELS["bun"] = payload
+                for path in (self.chart(), self.chart("dark"), self.hero()):
+                    root = self.assert_well_formed(path)
+                    self.assert_drawn(path, payload)  # (text, not markup: drawn as it was given)
+                    self.assertEqual([e for e in root.iter() if e.tag == SVG + "script"], [])
+                    self.assertNotIn("onmouseover", attribute_names(root))
+                    self.assertNotIn("onload", attribute_names(root))
+
+    def test_titles_and_step_names_cannot_inject_markup(self):
+        for payload in PAYLOADS:
+            with self.subTest(payload=payload):
+                # Step names come from pauses.jsonl and reach a panel's name ("Frame time p99, md:20000").
+                panels = [(f"Frame time p99, {payload}", "ms", {"pi-bolt": 12.0, "bun": 30.0})]
+                tiles = [(payload, "ms", {"pi-bolt": 412.0, "bun": 1196.0}, "faster")]
+                for path in (self.chart(title=payload, subtitle=payload, panels=panels),
+                             self.hero(title=payload, subtitle=payload, tiles=tiles),
+                             self.hero(compare=[("bun", payload)])):
+                    self.assert_well_formed(path)
+                    self.assert_drawn(path, payload)
+
+    def test_hero_figure_keeps_its_tspan(self):
+        root = self.assert_well_formed(self.hero())
+        figure = next(e for e in root.iter(SVG + "text") if e.get("font-size") == "36")
+        units = list(figure.iter(SVG + "tspan"))
+        self.assertEqual(len(units), 1)
+        self.assertEqual(units[0].text, "ms")
+        self.assertEqual("".join(figure.itertext()), "412ms")
+        # The unit is the tspan's text, its markup left as this file writes it (not an escaped tspan).
+        self.assertNotIn("&lt;tspan", ET.tostring(figure, encoding="unicode"))
+
+    def test_main_escapes_labels(self):
+        results = self.dir / "results"
+        results.mkdir()
+        bench, streams, long_rows = [], [], []
+        for build, factor in (("pi-bolt", 1.0), ("bun", 2.0)):
+            bench += [
+                {"ok": True, "build": build, "scenario": "interactive", "tti_ms": 412 * factor, "cpu_ms": 900 * factor,
+                 "peak_mb": 120 * factor, "peak_fp_mb": 80 * factor},
+                {"ok": True, "build": build, "scenario": "startup", "wall_ms": 31 * factor, "cpu_ms": 15 * factor},
+                {"ok": True, "build": build, "scenario": "headless", "wall_ms": 300 * factor, "cpu_ms": 250 * factor},
+            ]
+            streams.append({"build": build, "prompt_cpu_ms": 500 * factor, "memory_at_end": {"own": 90 * factor}})
+            long_rows.append({"build": build, "prompt": 40, "ms_per_prompt": 900 * factor, "cpu_ms_per_prompt": 800 * factor,
+                              "own_mb": 300 * factor, "tokens_m": 4.2})
+        for name, rows in (("benchmark.jsonl", bench), ("tmux.jsonl", streams), ("long.jsonl", long_rows)):
+            (results / name).write_text("\n".join(json.dumps(r) for r in rows) + "\n")
+        (results / "environment.txt").write_text("bun: Pi 1.0.0 on stock Bun 1.4.2\n")
+        images = self.dir / "images"
+        payload = 'A & B <script>alert(1)</script> "c"'
+        argv = ["report.py", str(results), "--images", str(images), "--builds", "pi-bolt,bun", "--label", f"bun={payload}"]
+        with contextlib.redirect_stdout(io.StringIO()), mock.patch.object(sys, "argv", argv):
+            report.main()
+        svgs = sorted(images.glob("*.svg"))
+        self.assertTrue(svgs, "no chart was written")
+        for path in svgs:
+            self.assert_well_formed(path)
+            self.assert_drawn(path, payload)
+        self.assertNotIn("&amp;amp;", (images / "bench-speed-light.svg").read_text())
+        # The CLI and the tables are as they were: the label reaches them as given.
+        self.assertEqual(report.LABELS["bun"], payload)
+
+
+if __name__ == "__main__":
+    unittest.main()
